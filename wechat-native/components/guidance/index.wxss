.guidance{margin:8px 0 14px;border:1px solid #d8ebe2;border-radius:18px;background:#f5f8f4;color:var(--journey-ink,#4e392e);overflow:hidden;text-align:left}.guidance button{margin:0;font-size:16px;line-height:1.5;color:inherit}.guidance button:after{border:0}.guidance text{line-height:1.75}.row{display:flex;align-items:center;justify-content:space-between;gap:8px}.guide-toggle{width:100%;min-height:46px;padding:11px 13px;background:transparent;text-align:left}.guide-toggle>text:first-child{font-size:14px;font-weight:650}.toggle-label{font-size:13px;color:var(--journey-accent-strong,#246d50);flex-shrink:0}.guide-content{padding:0 13px 13px}.caption{display:block;font-size:14px;color:#665348;line-height:1.75;margin:8px 0;word-break:break-all}.bold{font-weight:650}.guide-heading{font-size:15px;font-weight:650}.close{display:flex;align-items:center;justify-content:center;width:36px;height:36px;line-height:36px!important;background:transparent;color:#7f6c5d;font-size:22px!important;padding:0;flex-shrink:0}.moods{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:5px;margin:12px 0}.moods button{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:5px;min-height:76px;min-width:0;padding:8px 3px;border:1px solid #ebddd0;border-radius:11px;background:#fffcf8;color:#73533e;font-size:13px}.moods .selected{border-color:var(--journey-accent,#3b9a70);background:#f3e5d8}.mood-symbol{font-family:Georgia,serif;font-size:25px;line-height:1!important}.assess-link{width:100%;min-height:44px;padding:10px;border-radius:11px;background:#ebf5f1;color:var(--journey-accent-strong,#246d50)!important;text-align:left}.assess-link>view{display:flex;align-items:center;gap:6px;flex-wrap:wrap}.private{display:block;font-size:12px;line-height:1.75;color:#665348;margin-top:10px;word-break:break-all}.assess-link .private{margin:0}.recent{display:flex;align-items:center;flex-wrap:wrap;gap:5px;margin-top:10px;font-size:12px;color:#665348}.recent button{min-height:40px;padding:4px 5px;border-radius:6px;background:transparent;color:var(--journey-accent-strong,#246d50);font-size:12px}.scale-list{display:flex;flex-direction:column;gap:9px;margin:12px 0}.scale-list>button{display:flex;align-items:center;justify-content:space-between;gap:8px;padding:13px;min-height:68px;border:1px solid #e9dacc;border-radius:11px;background:#fffcf8;text-align:left}.scale-list>button>view{min-width:0;flex:1}.scale-list .bold{display:block;font-size:14px;font-weight:700;line-height:1.5}.scale-list .private{margin-top:5px;font-size:13px;line-height:1.5}.guide-score{margin:10px 0 12px;color:var(--journey-accent-strong,#246d50)}.guide-score>text:first-child{font-size:32px;font-weight:650;line-height:1.5}.guide-score>text:last-child{font-size:15px;line-height:1.5}.support{display:block;background:#fff2ee;border:1px solid #e1b9ad;border-radius:10px;padding:12px;font-size:13px;line-height:1.75;color:#8c4537;margin:12px 0}.actions{display:flex;flex-wrap:wrap;justify-content:space-between;gap:8px;margin-top:14px}.primary,.secondary{display:inline-flex;align-items:center;justify-content:center;gap:5px;min-height:44px;padding:9px 12px;border-radius:10px;font-size:16px!important;line-height:1.5}.guidance .primary{background:var(--journey-accent-strong,#246d50);color:#fff;border:1px solid var(--journey-accent-strong,#246d50)}.guidance .secondary{border:1px solid #dccaba;background:#fffcf8;color:#73533e}.text-button{background:transparent;color:#665348;padding:10px 0;min-height:44px}.answer-item{margin-bottom:10px}.answer-item>text{display:block}.answer-item .bold{margin-top:2px;color:#594436;font-weight:500}.supplement{margin:16px 0 0;padding-top:14px;border-top:1px solid #e5d8cc}.supplement textarea{box-sizing:border-box;width:100%;height:130.8px;margin-top:10px;border:1px solid #d5c1b0;border-radius:10px;padding:10px 12px;background:#fffcf8;font-size:16px;line-height:1.7;color:#4e392e}.share-note{display:flex;gap:9px;align-items:flex-start;font-size:14px;margin:14px 0 8px}.share-note>text{line-height:1.7}.share-box{position:relative;width:18px;height:18px;flex:none;margin-top:3px}.share-box checkbox{position:absolute;inset:0;opacity:0;width:18px;height:18px}.share-mark{width:18px;height:18px;border:1px solid #767676;border-radius:2px;background:#fff}.share-box.checked .share-mark{background:#246d50;border-color:#246d50}.share-box.checked .share-mark:after{content:"";display:block;width:5px;height:9px;border:solid #fff;border-width:0 2px 2px 0;transform:translate(5px,1px) rotate(45deg)}.share-box.disabled .share-mark{background:#f5f6f5;border-color:#cecfce}

.inline-icon{width:17px;height:17px;vertical-align:middle;margin-right:4px}.toggle-title{display:flex;align-items:center;gap:6px;min-width:0;font-weight:650;font-size:14px}.close .inline-icon{margin:0}

@media(max-width:350px){.guide-content,.guide-toggle{padding-right:10px;padding-left:10px}.moods{grid-template-columns:repeat(3,minmax(0,1fr));gap:6px}.guidance .primary,.guidance .secondary{padding-right:9px;padding-left:9px}}

.source-links{display:flex;align-items:center;flex-wrap:wrap}.source-links .text-button{min-height:0;font-size:12px;display:inline-flex;padding:0;text-decoration:none;line-height:1.75}.guidance .support{border:0;border-radius:0;background:transparent;color:#9a492f;font-size:14px;line-height:1.75;margin:10px 0 0;padding:0}

.guide-toggle{gap:6px}.toggle-title text{line-height:1.5}.toggle-title .inline-icon,.assess-link .inline-icon{flex:none;margin:0}.assess-link .bold{font-size:14px;font-weight:600;line-height:1.5}.assess-link .private{line-height:1.5}
.toggle-label{display:flex;align-items:center;gap:6px}.toggle-chevron{width:15px;height:15px;flex:none}
.guide-content>.caption{margin:0}
.guidance .actions>.primary,.guidance .actions>.secondary{width:auto;min-width:0;flex:0 0 auto;margin:0;box-shadow:none;font-weight:400}.actions .inline-icon{width:15px;height:15px;margin:0;flex:none}
.guide-arrow{width:16px;height:16px;margin:0;flex:none}.recent .guide-arrow{width:12px;height:12px}.recent button{display:inline-flex;align-items:center;justify-content:center;gap:4px}


.mood-symbol-image{display:block;width:25px;height:25px;flex:none}
.row>.guide-heading{line-height:1.6}.guide-result>.caption,.supplement>.caption{margin:0}.supplement>.guide-heading{display:block;font-size:14px;font-weight:700;line-height:1.6;margin-bottom:8px}.guidance .answer-disclosure{display:flex;align-items:center;text-align:left;padding:8px 0;margin-top:12px;min-height:0;background:transparent;color:#665348;font-size:13px;line-height:1.75}.answer-disclosure:before{content:"";width:0;height:0;border:4px solid transparent;border-left:6px solid currentColor;margin-right:4px}.answer-disclosure.open:before{transform:rotate(90deg)}.answer-details{font-size:13px;line-height:1.75;color:#665348}.answer-list{margin:8px 0;padding-left:20px}.answer-note{display:block}.guidance .primary[disabled],.guidance .secondary[disabled]{opacity:.48}.guidance .primary[disabled]{background:var(--journey-accent-strong,#246d50);color:#fff}
 .guide-result>.caption>.bold{font-weight:700}

.guidance .moods button[disabled]{opacity:.48;color:#73533e;background:#fffcf8}.guidance .moods button.selected[disabled]{background:#f3e5d8}


.guidance .moods button>text:last-child{line-height:1.5}
