<view wx:if="{{question}}" class="questionnaire {{variant}}-questionnaire"><view class="questionnaire-row"><text class="questionnaire-title">{{title}}</text><text class="questionnaire-step">{{index+1}} / {{questions.length}}</text></view><text class="questionnaire-description">{{questionDescription}}</text><progress percent="{{answered/questions.length*100}}" stroke-width="5" activeColor="{{variant === 'wellness' ? '#9672b8' : accentColor}}" backgroundColor="{{variant === 'wellness' ? '#ece5f2' : '#eadfd4'}}"/><text class="questionnaire-number">第 {{index+1}} 题</text><text class="questionnaire-question">{{question.text}}</text><view class="questionnaire-options"><button wx:for="{{question.options}}" wx:key="*this" data-value="{{index}}" bindtap="choose" class="questionnaire-option {{choice === index ? 'selected' : ''}}"><text class="radio-dot {{choice === index ? 'checked' : ''}}"></text><text>{{item}}</text><image wx:if="{{choice === index && variant === 'wellness'}}" class="wellness-check" src="/assets/icons/wellness-check.png"/><text wx:if="{{choice === index && variant !== 'tang' && variant !== 'wellness'}}" class="tick">✓</text></button></view><text wx:if="{{support}}" class="questionnaire-support">{{supportText}}</text><text wx:if="{{error}}" class="questionnaire-error">{{error}}</text><view class="questionnaire-actions"><button class="questionnaire-secondary" bindtap="previous" disabled="{{index === 0}}"><image wx:if="{{variant === 'tang'}}" class="questionnaire-icon" src="/assets/icons/guidance-back.png"/><image wx:elif="{{variant === 'wellness'}}" class="wellness-nav-icon" src="/assets/icons/wellness-back.png"/>{{variant === 'tang' || variant === 'wellness' ? '' : '← '}}上一题</button><button class="questionnaire-primary" bindtap="next" disabled="{{variant === 'tang' && choice === null}}">{{index === questions.length-1 ? '查看结果' : '下一题'}}<image wx:if="{{variant === 'tang'}}" class="questionnaire-icon" src="/assets/icons/guidance-arrow-white.png"/><image wx:elif="{{variant === 'wellness'}}" class="wellness-nav-icon" src="/assets/icons/guidance-arrow-white.png"/>{{variant === 'tang' || variant === 'wellness' ? '' : ' →'}}</button></view><button class="questionnaire-close" bindtap="close"><image wx:if="{{variant === 'tang'}}" class="questionnaire-cancel-icon" src="/assets/icons/guidance-cancel.png"/>{{variant === 'tang' ? '取消本次答题' : '退出答题（不保存）'}}</button></view>
