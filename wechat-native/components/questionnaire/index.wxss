.questionnaire{border:1px solid #e9dacc;border-radius:16px;background:#fff;padding:18px 16px;color:var(--journey-ink,#4e392e)}.questionnaire-row{display:flex;align-items:center;justify-content:space-between;gap:8px}.questionnaire-title{font-size:16px;font-weight:700}.questionnaire-step{font-size:13px;padding:3px 7px;border-radius:9px;background:#f2e4d7;color:#73533e;white-space:nowrap}.questionnaire-description{display:block;color:#716a63;font-size:13px;line-height:1.75;margin:12px 0}.questionnaire progress{margin:12px 0 15px}.questionnaire-number{display:block;font-size:11px;color:var(--journey-accent-strong,#246d50);margin:8px 0}.questionnaire-question{display:block;font-size:16px;font-weight:600;line-height:1.75;margin-bottom:12px}.questionnaire-options{display:flex;flex-direction:column;gap:8px}.questionnaire-option{display:flex;align-items:center;gap:9px;min-height:48px;padding:10px 12px;border:1px solid #e4dfd9;border-radius:10px;background:#fffcf8;color:inherit;font-size:15px;line-height:1.65;text-align:left;margin:0}.questionnaire-option:after,.questionnaire button:after{border:0}.questionnaire-option.selected{border-color:var(--journey-accent-strong,#246d50);background:#f2e4d7}.radio-dot{flex-shrink:0;width:14px;height:14px;border-radius:50%;border:1px solid #c6b3a2}.radio-dot.checked{border:5px solid var(--journey-accent-strong,#246d50);box-sizing:border-box}.tick{margin-left:auto;font-size:18px;color:var(--journey-accent-strong,#246d50)}.questionnaire-actions{display:flex;justify-content:space-between;gap:8px;margin-top:14px}.questionnaire-primary,.questionnaire-secondary{margin:0;min-height:44px;padding:10px 12px;border-radius:10px;font-size:14px;line-height:1.5}.questionnaire-primary{background:var(--journey-accent-strong,#246d50);color:#fff}.questionnaire-secondary{background:#fffcf8;color:var(--journey-accent-strong,#246d50);border:1px solid #dccaba}.questionnaire-error{display:block;color:#ac3f37;font-size:12px;margin:10px 0}.questionnaire-support{display:block;color:#8c4537;background:#fff2ee;border:1px solid #e1b9ad;border-radius:10px;padding:12px;font-size:13px;line-height:1.75;margin-top:12px}.questionnaire-close{display:block;min-height:44px;margin:7px auto -6px;padding:7px;background:transparent;color:#716a63;font-size:13px}

.wellness-questionnaire{border-color:#e8e1ee;border-radius:20px;padding:20px}.wellness-questionnaire .questionnaire-description{color:#766f80}.wellness-questionnaire .questionnaire-option{background:#fff}.wellness-questionnaire .questionnaire-step{background:#f2edf8;color:#735596}.wellness-questionnaire .questionnaire-secondary{background:#f6f2f9;border-color:#e3d9ee;color:var(--journey-accent-strong,#5c528b)}

.tang-questionnaire{padding:0;border:0;border-radius:0;background:transparent}.tang-questionnaire .questionnaire-title{font-size:15px;font-weight:650;line-height:1.6}.tang-questionnaire .questionnaire-description{color:#665348;font-size:14px;margin:0}.wellness-questionnaire .questionnaire-title{font-size:16px;font-weight:400;line-height:1.6}.wellness-questionnaire .questionnaire-description{font-size:12px;line-height:1.85;margin:10px 0}.wellness-questionnaire progress{margin:16px 0 24px;border-radius:8px;overflow:hidden}.wellness-questionnaire .questionnaire-number{color:#9a82b1;font-weight:500;letter-spacing:1px;margin-bottom:8px}.wellness-questionnaire .questionnaire-question{font-size:17px;font-weight:600;line-height:1.75}.wellness-questionnaire .questionnaire-options{gap:10px;margin-top:20px}.wellness-questionnaire .questionnaire-option{gap:10px;min-height:50px;padding:12px;border-color:#e6e1eb;border-radius:12px;font-size:13px;line-height:1.6}.wellness-questionnaire .questionnaire-option.selected{border-color:#a184bf;background:#f3edf9;color:#684786}.wellness-questionnaire .radio-dot{width:17px;height:17px;box-sizing:border-box;border-color:#767676;background:#fff}.wellness-questionnaire .radio-dot.checked{border:1px solid #805ca5;background:#805ca5;box-shadow:inset 0 0 0 3px #fff}.wellness-questionnaire .questionnaire-actions{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;margin-top:24px}.wellness-questionnaire .questionnaire-primary,.wellness-questionnaire .questionnaire-secondary{display:flex;align-items:center;justify-content:center;gap:7px;padding:10px 16px;min-height:44px;border-radius:12px;font-size:16px;font-weight:400;line-height:1.4}.wellness-questionnaire .questionnaire-primary{background:var(--journey-accent-strong,#5c528b);color:#fff}.wellness-questionnaire .questionnaire-step{padding:5px 10px;border-radius:20px;font-size:12px}.wellness-questionnaire .questionnaire-close{display:inline-block;width:max-content;margin:0;font-size:16px;line-height:24px;padding:8px 0;color:#79618f}.wellness-check{width:17px;height:17px;flex:none;margin-left:auto}.wellness-nav-icon{width:16px;height:16px;flex:none}
@media(max-width:360px){.wellness-questionnaire{padding:15px}.wellness-questionnaire .questionnaire-question{font-size:16px}}

.tang-questionnaire .questionnaire-number{display:none}.tang-questionnaire .questionnaire-question{font-size:15px}.tang-questionnaire .questionnaire-support{border:0;border-radius:0;background:transparent;color:#9a492f;font-size:14px;margin-top:10px;padding:0}.tang-questionnaire .questionnaire-primary[disabled]{opacity:.48;background:var(--journey-accent-strong,#246d50);color:#fff}

.tang-questionnaire .radio-dot{width:16px;height:16px;box-sizing:border-box;border-color:#767676;background:#fff}

.tang-questionnaire .questionnaire-option{border-color:#e9dacc;color:#5e493b;font-size:15px!important;line-height:1.65!important}.tang-questionnaire .questionnaire-option.selected{border-color:var(--journey-accent-strong,#246d50)}.tang-questionnaire .questionnaire-secondary{padding:9px 12px;color:#73533e!important}
.tang-questionnaire .questionnaire-primary,.tang-questionnaire .questionnaire-secondary{display:inline-flex;align-items:center;justify-content:center;gap:5px;font-size:16px!important;line-height:1.5!important;padding:9px 12px;flex:none;width:auto;min-width:0}.tang-questionnaire .questionnaire-primary{border:1px solid var(--journey-accent-strong,#246d50);color:#fff!important}
.wellness-questionnaire .questionnaire-primary,.wellness-questionnaire .questionnaire-secondary{line-height:24px}.wellness-questionnaire .questionnaire-primary{border:1px solid transparent}
.tang-questionnaire .questionnaire-step{line-height:1.5}.tang-questionnaire .questionnaire-row{margin-bottom:8px}.tang-questionnaire .radio-dot.checked{border:1px solid var(--journey-accent-strong,#246d50);background:var(--journey-accent-strong,#246d50);box-shadow:inset 0 0 0 2px #fff}.tang-questionnaire .questionnaire-close{display:flex;align-items:center;justify-content:center;gap:4px;margin:7px auto -6px!important;color:#665348!important}.tang-questionnaire button[disabled]{opacity:.48}.tang-questionnaire .questionnaire-secondary[disabled]{background:#fffcf8}.tang-questionnaire .questionnaire-icon{width:15px;height:15px;flex:none}.tang-questionnaire .questionnaire-cancel-icon{width:14px;height:14px;flex:none}
.tang-questionnaire .questionnaire-option>text{line-height:1.65}

.wellness-questionnaire .questionnaire-number{line-height:1.75}.wellness-questionnaire .questionnaire-close{display:block;width:max-content}.wellness-questionnaire .questionnaire-actions button.questionnaire-secondary[disabled]{opacity:.5;color:var(--journey-accent-strong,#5c528b);background:#f6f2f9}
