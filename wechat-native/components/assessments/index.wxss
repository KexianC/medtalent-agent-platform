.assessment-workspace{padding:20px}.assessment-title{display:block;font-size:19px;font-weight:600;margin:12px 0}.assessment-copy{display:block;color:#62746e;font-size:13px;line-height:1.7;margin:8px 0}.assessment-choice{display:flex;justify-content:space-between;text-align:left;padding:16px;border:1px solid #e1e9e4;border-radius:14px;background:white;margin:12px 0;font-size:14px}.assessment-choice text+text{font-size:12px;color:#62746e}.assessment-question{padding:16px;border:1px solid #dce7df;border-radius:14px;margin:14px 0;font-size:14px}.assessment-question label{display:flex;align-items:center;gap:10px;margin-top:14px}.assessment-result{padding:16px;border-bottom:1px solid #e1e9e4}.assessment-result button{display:inline-block;margin-right:12px;font-size:13px}
