<view class="{{layoutClass}} assessment-workspace"><text wx:if="{{readOnly}}" class="assessment-copy">此组件为只读，可查看和删除已有记录。</text><view class="panel-intro"><text class="eyebrow">PERSONAL SELF-CHECK</text><text class="panel-heading">健康自评</text><text class="panel-lead">按实际感受作答；自评用于个人观察，不用于诊断或治疗决定。</text></view><view wx:if="{{active}}"><text class="assessment-title">{{active.title}}</text><text wx:if="{{active.source}}" class="assessment-copy">来源：{{active.source}}</text><text wx:if="{{active.version}}" class="assessment-copy">版本：{{active.version}}</text><text class="assessment-copy">{{active.description}}</text><view wx:for="{{questions}}" wx:for-item="question" wx:key="id" class="assessment-question"><text>{{question.index}}. {{question.text}}</text><radio-group data-id="{{question.id}}" bindchange="answer"><label wx:for="{{question.choices}}" wx:key="choice"><radio value="{{item.choice}}" checked="{{item.checked}}" disabled="{{!canEdit}}"/><text>{{item.label}}</text></label></radio-group></view><button class="primary" bindtap="save" disabled="{{!canEdit}}">保存自评</button><button class="secondary" bindtap="cancel">取消</button></view><view wx:else><button wx:for="{{definitions}}" wx:key="id" data-id="{{item.id}}" bindtap="open" class="assessment-choice"><text>{{item.title}}</text><text>{{item.questions.length}} 项问题</text></button><text wx:if="{{!definitions.length}}">暂未配置自评量表。</text></view><text wx:if="{{notice}}" class="assessment-copy">{{notice}}</text><view wx:if="{{storageNotice}}"><text>{{storageNotice}}</text><button class="secondary" bindtap="retry">重试保存</button></view><view wx:if="{{results.length}}"><text class="assessment-title">自评记录</text><view wx:for="{{results}}" wx:key="id" class="assessment-result"><text>{{item.title}} · 总分 {{item.score}}</text><text wx:if="{{item.source}}" class="assessment-copy">来源：{{item.source}}</text><text wx:if="{{item.definitionVersion}}" class="assessment-copy">版本：{{item.definitionVersion}}</text><text wx:if="{{item.resultLabel}}" class="assessment-copy">{{item.resultLabel}}：{{item.resultDescription}}（仅供个人观察，不构成诊断）</text><text class="assessment-copy">{{item.dateLabel}}</text><button class="secondary" data-id="{{item.id}}" bindtap="ask">带记录咨询</button><button class="secondary" data-id="{{item.id}}" bindtap="remove" disabled="{{!canDelete}}">删除</button></view></view></view>