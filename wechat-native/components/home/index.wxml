<view wx:if="{{doctor && exp}}" class="{{layoutClass}} journey-home {{isTang ? 'journey-tang-home' : ''}} {{generic ? 'is-generic-agent' : ''}}">
  <view class="journey-hero">
    <view class="journey-topbar"><view class="journey-brandline"><view><image src="{{icons.baby}}"/></view><text>{{exp.tagline}}</text></view><view wx:if="{{!isYuwen}}" class="journey-notice-wrap"><button class="journey-icon-button" bindtap="toggleNotice" aria-label="查看提醒"><image src="{{icons.bell}}"/><view wx:if="{{reminderEnabled}}" class="notice-dot"/></button><view class="journey-notice {{noticeMotion}}" style="{{noticeStyle}}" wx:if="{{noticeMounted}}"><text class="notice-title">健康提醒</text><text class="notice-copy">{{reminder}}</text></view></view></view>
    <view class="journey-doctor-heading {{homeFadeClass}}"><view class="journey-doctor-copy"><text class="journey-eyebrow">{{exp.eyebrow}}</text><view class="journey-name-row"><text class="doctor-name">{{doctor.name}}</text><text class="doctor-department">{{doctor.department}}</text></view><text class="doctor-hospital">{{doctor.hospital}}</text><text class="doctor-specialty">{{isTang ? '一起梳理困扰，找到下一步' : doctor.specialty}}</text></view><view class="journey-hero-art {{usesGrowth ? 'has-image' : ''}}"><image wx:if="{{usesGrowth}}" class="hero-illustration" src="{{growthHero}}" mode="aspectFill"/><block wx:else><view class="hero-symbol"><image src="{{heroArt}}"/></view><view class="hero-orbit orbit-one"/><view class="hero-orbit orbit-two"/></block></view></view>
    <scroll-view scroll-x class="{{!isTang && !isYuwen ? 'journey-specialty-tags ordinary-home-tags' : 'journey-specialty-tags'}}"><text wx:for="{{tags}}" wx:key="*this">{{item}}</text></scroll-view>
    <view class="journey-tang-start" wx:if="{{isTang}}"><button class="journey-primary-button" hover-class="primary-pressed" hover-start-time="0" hover-stay-time="0" bindtap="ask"><image class="tang-chat-icon" src="{{icons.chatFillWhite}}"/>开始对话<image src="{{icons.chevronWhite}}"/></button><text>聊聊最近的睡眠、情绪，或你正在经历的困扰。</text></view>
  </view>
  <view wx:if="{{builderMode}}" class="builder-home-sections"><block wx:for="{{builderBlocks}}" wx:key="id"><native-health wx:if="{{item.id === 'records'}}" doctor="{{doctor}}" experience="{{exp}}" bind:ask="forwardAsk"/><native-assessments wx:elif="{{item.id === 'assessments'}}" doctor="{{doctor}}" bind:ask="forwardAsk"/><native-education wx:elif="{{item.id === 'content'}}" mode="published" title="{{item.label}}" doctor="{{doctor}}" experience="{{exp}}" bind:ask="forwardAsk" bind:navigate="forwardNavigate"/><native-education wx:elif="{{item.id === 'services'}}" mode="services" compact="{{true}}" doctor="{{doctor}}" experience="{{exp}}" bind:ask="forwardAsk" bind:navigate="forwardNavigate"/><native-wellness wx:elif="{{item.id === 'wellness'}}" doctor="{{doctor}}" section="services" bind:ask="forwardAsk"/><view wx:elif="{{item.id === 'chat' || item.id === 'voice'}}" class="journey-assessment builder-home-module"><text class="assessment-title">{{item.label}}</text><text class="assessment-copy">{{item.id === 'voice' ? '可以用语音描述问题，也可以继续打字交流。' : doctor.welcomeMessage || '围绕健康问题进行科普问答与就医准备。'}}</text><button class="journey-primary-button" bindtap="ask">开始对话<image src="{{icons.chevronWhite}}"/></button></view></block></view>
  <view class="yw-home" wx:elif="{{isYuwen}}">
    <view wx:if="{{storageNotice}}" class="storage-notice">{{storageNotice}}</view>
    <view class="yw-card yw-home-journal"><text class="journey-eyebrow">A MOMENT FOR YOURSELF</text><text class="yw-heading">今天，过得怎么样？</text><text class="yw-copy">慢一点，记录睡眠，也听一听自己的心情。</text><view class="yw-home-stats"><view><text class="yw-stat-value">{{wellnessDays}}<text class="yw-stat-unit"> / 7</text></text><text class="yw-stat-label">近七日记录天数</text></view><view><text class="yw-stat-value">{{wellnessMood}}<text class="yw-stat-unit">{{wellnessHasMood ? ' / 10' : ''}}</text></text><text class="yw-stat-label">{{wellnessHasMood ? '近七日平均心情' : '等待第一份心情记录'}}</text></view></view><button class="journey-primary-button" hover-class="primary-pressed" hover-start-time="0" hover-stay-time="0" data-view="diary" bindtap="wellness">{{wellnessToday ? '继续记录今天' : '写下今日感受'}}<image src="{{icons.chevronWhite}}"/></button><button class="yw-text-button" data-view="report" bindtap="wellness">查看我的趋势报告</button></view>
    <view class="yw-section-title"><view><text class="journey-eyebrow">YOUR WELLNESS SPACE</text><text class="yw-section-heading">{{doctor.name}}的身心空间</text></view><image src="{{icons.moon}}"/></view>
    <view class="yw-feature-grid"><button wx:for="{{wellnessFeatures}}" wx:key="id" data-view="{{item.id}}" bindtap="wellness"><view class="feature-symbol"><image src="{{item.iconUrl}}"/></view><text class="feature-title">{{item.title}}</text><text class="feature-copy">{{item.description}}</text><image class="feature-arrow" src="{{icons.featureChevron}}"/></button></view>
  </view>
  <view class="journey-assessment {{homeFadeClass}}" wx:elif="{{showRecords}}">
    <view class="journey-card-heading"><view><text class="journey-eyebrow">YOUR HEALTH JOURNEY</text><text class="assessment-title">{{title}}</text><text class="assessment-copy">{{subtitle}}</text></view><view class="journey-live-badge"><view/>关注健康每一步</view></view>
    <view wx:if="{{storageNotice}}" class="storage-notice">{{storageNotice}}</view>
    <view class="journey-tang-record-summary" wx:if="{{isTang}}"><text>近7日已记录 <text class="record-count">{{recordedDays}} / 7 天</text></text><button bindtap="manage">查看趋势<image src="{{icons.trendChevron}}"/></button></view>
    <view class="journey-metric {{usesGrowth ? 'growth-metric' : ''}}" wx:else><view class="journey-metric-copy"><text class="metric-label">近 7 日记录完成度</text><text class="metric-value">{{recordedDays}} / 7 天</text><text class="metric-note">{{recordedDays ? '按实际填写日期统计，可在管理页查看趋势' : '填写第一条记录后，这里会显示实际进度'}}</text></view><image wx:if="{{usesGrowth}}" class="metric-illustration" src="{{growthMetric}}" mode="aspectFill"/><view class="journey-metric-progress" wx:else><view class="progress-track"><view class="progress-fill" style="width:{{progress}}%"><view class="progress-dot"/></view></view><view class="progress-labels"><text>起点</text><text>本周</text><text>目标</text></view></view></view>
    <view class="journey-step-list"><button wx:for="{{steps}}" wx:key="title" class="{{item.complete ? 'is-complete' : ''}}" data-section="{{item.section}}" bindtap="openRecord"><view class="step-symbol"><image src="{{item.iconUrl}}"/></view><view class="step-copy"><text class="step-title">{{item.title}}<text wx:if="{{item.complete}}" class="step-complete"> · 今日已记录</text></text><text class="step-description">{{item.description}}</text></view><text class="step-number">{{item.number}}</text><image class="step-arrow" src="{{icons.chevron}}"/></button></view>
    <view class="journey-card-actions"><button class="journey-primary-button" hover-class="primary-pressed" hover-start-time="0" hover-stay-time="0" bindtap="openRecord">{{cta}}<image src="{{icons.chevronWhite}}"/></button><view class="journey-privacy"><image src="{{isTang ? '/assets/icons/shield-home-privacy-tang.png' : '/assets/icons/shield-home-privacy.png'}}"/><text>信息仅用于健康记录与科普，不替代医生诊断</text></view><view wx:if="{{lastDate}}" class="journey-last-record"><image src="{{icons.clock}}"/><text>最近记录：{{lastDate}}</text></view></view>
  </view>
  <view wx:if="{{!builderMode}}" class="{{isTang ? 'journey-tang-disclosure journey-tang-resources' : ''}}"><button wx:if="{{isTang}}" class="disclosure-summary" bindtap="toggleResources">健康科普与近期关注<image src="{{icons.disclosureChevron}}" class="{{resourcesOpen ? 'rotated' : ''}}"/></button><view hidden="{{isTang && !resourcesOpen}}"><view class="journey-concerns {{concernsFadeClass}}"><view class="concerns-heading"><view><text class="journey-eyebrow">WEEKLY FOCUS</text><text class="concerns-title">本周大家最关心</text></view><image src="{{icons.chat}}"/></view><button wx:for="{{concerns}}" wx:key="title" data-question="{{item.title}}" bindtap="ask"><view class="concern-symbol"><image src="{{item.iconUrl}}"/></view><view class="concern-copy"><text class="concern-title">{{item.title}}</text><text class="concern-description">{{item.description}}</text></view><image class="concern-arrow" src="{{icons.chevron}}"/></button></view><native-education wx:if="{{showContent}}" mode="published" doctor="{{doctor}}" experience="{{exp}}" bind:ask="forwardAsk" bind:navigate="forwardNavigate"/></view></view>
  <view class="journey-tang-disclosure" wx:if="{{isTang}}"><button class="disclosure-summary" bindtap="toggleAbout">了解{{doctor.name}}智能体<image src="{{icons.disclosureChevron}}" class="{{aboutOpen ? 'rotated' : ''}}"/></button><view wx:if="{{aboutOpen}}" class="about-copy"><text>{{doctor.title}}</text><text>{{doctor.specialty}}</text><text>{{doctor.intro}}</text><text>信息仅用于健康科普与就医准备，不替代医生诊断。</text></view></view>
  <view class="journey-expert-note" wx:else><view class="expert-initial">{{doctorInitial}}</view><view class="expert-copy"><text class="expert-title">{{doctor.name}}{{generic ? '智能体' : '医生智能体'}}</text><text class="expert-description">{{doctor.intro}}</text></view><button bindtap="ask">立即提问</button></view>
</view>
<view wx:if="{{sheetOpen}}" class="native-sheet-backdrop {{backdropMotion}}" bindtap="closeSheet"><view class="native-sheet journey-tang-home-sheet sheet-distance-60 {{sheetMotion}}" catchtap="preventClose"><scroll-view enhanced show-scrollbar="{{false}}" class="sheet-scroll" style="height:{{sheetHeight + 41}}px" scroll-y scroll-into-view="{{sheetScroll}}"><view class="sheet-scroll-padding"><view class="sheet-handle"/><view class="sheet-content"><button class="sheet-close" bindtap="closeSheet" aria-label="关闭睡眠与状态记录"><image src="{{icons.close}}"/></button><block wx:if="{{!saved}}"><text class="journey-eyebrow">DAILY HEALTH CHECK-IN</text><text class="sheet-title">今日睡眠与状态记录</text><text class="sheet-lead">按实际情况填写，不清楚的项目可以留空。同一天的睡眠、情绪和日常功能保存在一份记录中，可随时补充。</text><view wx:for="{{sections}}" wx:for-item="section" wx:key="id" class="record-section"><view id="record-{{section.id}}" class="record-scroll-anchor" aria-hidden="true"/><view class="record-section-title"><image src="{{section.iconUrl}}"/><view><text class="record-section-name">{{section.title}}</text><text class="record-section-description">{{section.description}}</text></view></view><view class="record-grid"><label wx:for="{{section.fields}}" wx:key="key" class="record-field"><text class="record-label">{{item.label}}</text><view class="record-input {{focusedDraftField === item.key ? 'draft-focused' : ''}}"><input placeholder-style="color:#9ca3af;opacity:1" value="{{draft[item.key]}}" type="{{item.type}}" data-key="{{item.key}}" bindinput="editDraft" placeholder="{{item.placeholder}}" focus="{{focusField === item.key}}" bindfocus="focusDraft" bindblur="blurDraft" disabled="{{!canEdit}}"/><text>{{item.unit}}</text></view><view wx:if="{{item.anchors.length}}" class="record-anchors"><text wx:for="{{item.anchors}}" wx:key="*this">{{item}}</text></view></label></view></view><label class="record-note"><text>补充备注（可选）</text><textarea class="{{focusedDraftField === 'note' ? 'draft-focused' : ''}}" placeholder-style="color:#9ca3af;opacity:1" value="{{draft.note}}" data-key="note" bindfocus="focusDraft" bindblur="blurDraft" bindinput="editDraft" maxlength="300" placeholder="例如：昨晚加班后入睡较慢，今天下午精力较差" disabled="{{!canEdit}}"/><text class="note-count">{{draft.note.length}} / 300</text></label><text wx:if="{{formError}}" class="form-error">{{formError}}</text><view class="home-sheet-actions"><button class="journey-primary-button" hover-class="primary-pressed" hover-start-time="0" hover-stay-time="0" bindtap="saveRecord" disabled="{{!canEdit}}"><image src="{{icons.save}}"/>保存今日记录</button><view class="journey-privacy"><image src="{{icons.lock}}"/><text>游客记录保存在本机，微信登录后保存到账户；仅在你主动选择时提供给{{doctor.name}}智能体</text></view></view><text wx:if="{{storageNotice}}" class="storage-notice">{{storageNotice}}</text></block><view wx:else class="sheet-success"><image src="{{icons.check}}"/><text class="sheet-title">今日记录已保存</text><text class="sheet-lead">{{savedMetricCount ? '已记录 ' + savedMetricCount + ' 项实际数据，并同步到管理页统计。' : '备注已保存，并同步到管理页历史记录。'}}</text><button class="journey-primary-button" hover-class="primary-pressed" hover-start-time="0" hover-stay-time="0" bindtap="askWithRecord"><image src="{{icons.chatFillWhite}}"/>带着记录去问智能体</button><button class="sheet-secondary" bindtap="closeSheet">返回首页</button></view></view></view></scroll-view></view></view>
