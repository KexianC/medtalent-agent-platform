<text wx:if="{{readOnly}}" class="{{layoutClass}} small muted">此组件为只读，可查看和删除已有记录。</text>
<wxs module="dateText">
function display(value) { return value ? value.split('-').join('/') : ''; }
module.exports = { display: display };
</wxs>
<view class="health-panel {{reduceMotion ? 'is-reduced-motion' : ''}} {{tang ? 'tang-health' : ''}}">
  <view class="intro"><text class="eyebrow">PERSONAL HEALTH LOG</text><text class="title">{{config.title}}</text><text class="description">{{config.description}}</text></view>
  <view wx:if="{{storageProblem}}" class="storage-warning {{storageIsError ? 'is-error' : ''}}"><image wx:if="{{tang}}" src="{{icons.shield}}"/><view class="storage-copy"><text class="bold">{{storageTitle}}</text><text wx:if="{{storageDetail}}">{{storageDetail}}</text></view><button wx:if="{{storageCanRetry}}" bindtap="retryStorage" disabled="{{storageRetrying}}">{{storageRetrying ? '正在重试…' : storageRetryLabel}}</button></view>
  <block wx:if="{{tang}}">
    <view class="range tang-range"><button class="{{days === 7 ? 'active' : ''}}" data-days="7" bindtap="changeRange">近7日</button><button class="{{days === 30 ? 'active' : ''}}" data-days="30" bindtap="changeRange">近30日</button></view>
    <view class="summary-grid"><view wx:for="{{summary}}" wx:key="label" class="summary-item"><text>{{item.label}}</text><text class="summary-number">{{item.value}}</text><text class="muted small">{{item.note}}</text></view></view>
    <view class="card tang-trend"><view class="row"><view><text class="eyebrow">TREND</text><text class="heading">自填趋势</text></view><text class="small muted">{{structuredCount ? '已有 ' + structuredCount + ' 条结构化记录' : '暂无可统计记录'}}</text></view><view class="tang-trend-selector"><button wx:for="{{trendFields}}" wx:key="key" data-index="{{index}}" bindtap="selectTangMetric" class="{{selectedIndex === index ? 'active' : ''}}">{{item.label}}</button></view><scroll-view wx:if="{{plot.hasData}}" scroll-x class="tang-trend-scroll"><view class="tang-trend-bars {{days === 30 ? 'is-long' : ''}}"><view wx:for="{{trendBars}}" wx:key="date" class="tang-trend-bar {{item.filled ? '' : 'is-empty'}}"><text>{{item.display}}</text><view class="tang-bar-track"><view style="height:{{item.percent}}%;"></view></view><text class="tang-bar-label">{{item.label}}</text></view></view></scroll-view><view wx:else class="empty"><image class="empty-symbol" src="{{icons.chartHeader}}"/><text>暂无{{selected.label}}记录</text><text class="muted small">填写该项后会生成趋势；缺失日期不会按 0 计算。</text></view><text class="help small">记录天数包含首页状态记录；均值和趋势仅统计量化自填数据，不代表诊断或疗效判断。</text></view>
    <view id="health-editor" class="card tang-editor"><view class="row"><view><text class="eyebrow">DAILY CHECK-IN</text><text class="heading">{{editingId ? '编辑健康记录' : '新增健康记录'}}</text></view><button wx:if="{{editingId}}" class="text-button" bindtap="startNew"><image class="inline-icon" src="{{icons.edit}}"/>新增/补录</button></view><view class="field date-field"><text>记录日期</text><picker mode="date" start="{{minDate}}" end="{{today}}" value="{{draft.dateKey}}" bindchange="changeDate"><view class="picker-value date-picker-value">{{dateText.display(draft.dateKey)}}<view class="date-calendar" aria-hidden="true"/></view></picker></view>
      <view class="tang-section-title"><image src="{{icons.moon}}"/><view><text>睡眠情况</text><text>不知道的项目可以留空</text></view></view><view class="field-grid tang-fields"><view wx:for="{{sleepFields}}" wx:key="key" class="field"><text>{{item.label}}</text><view class="number-field"><input type="digit" value="{{draft.values[item.key]}}" data-key="{{item.key}}" bindinput="changeValue" placeholder-style="color:#9ca3af;" placeholder="{{item.placeholder}}" maxlength="12" disabled="{{!canEdit}}"/><text>{{item.unit}}</text></view></view></view>
      <view class="tang-section-title"><image src="{{icons.brain}}"/><view><text>白天状态</text><text>均为 0–10 分的自我感受</text></view></view><view class="field-grid tang-fields"><view wx:for="{{scoreFields}}" wx:key="key" class="field"><text>{{item.label}}</text><view class="number-field"><input type="digit" value="{{draft.values[item.key]}}" data-key="{{item.key}}" bindinput="changeValue" placeholder-style="color:#9ca3af;" placeholder="0–10" maxlength="12" disabled="{{!canEdit}}"/><text>{{item.unit}}</text></view><view class="score-anchors"><text wx:for="{{item.anchors}}" wx:key="*this">{{item}}</text></view></view></view>
      <view class="note-field"><text>补充备注（可选）</text><textarea value="{{draft.note}}" bindinput="changeNote" maxlength="300" placeholder-style="color:#9ca3af;" placeholder="例如：昨晚加班后入睡困难，今天下午精力较差" disabled="{{!canEdit}}"/><text class="counter">{{draft.note.length}} / 300</text></view><text wx:if="{{error}}" class="error">{{error}}</text><text wx:if="{{notice}}" class="notice">{{notice}}</text><view class="tang-manage-actions"><button class="primary" hover-class="primary-pressed" hover-start-time="0" hover-stay-time="0" bindtap="saveRecord" disabled="{{!canEdit}}"><image class="inline-icon" src="{{icons.saveWhite}}"/>{{editingId ? '更新这条记录' : '保存健康记录'}}</button><button class="secondary" bindtap="openHistory"><image class="inline-icon" src="{{icons.clockSecondary}}"/>查看历史记录（{{records.length}}）</button></view>
    </view>
    <view class="tang-ai-card"><image src="{{icons.sparkle}}"/><view><text>让智能体参考近期记录</text><text>点击后会进入问答页；发送前仍可关闭。只提交最近记录的结构化摘要，不包含游客编号和记录 ID。</text></view><button bindtap="ask" disabled="{{!canShare}}">带记录提问 <image class="inline-icon" src="{{icons.chevronWhite}}"/></button></view>
    <button wx:if="{{showFab}}" class="tang-record-fab {{fabEntryMotion ? 'floating-enter' : ''}}" hover-class="floating-pressed" hover-start-time="0" hover-stay-time="0" aria-label="添加健康记录" bindtap="startNew"><image src="{{icons.plusWhite}}"/></button>
    <view wx:if="{{historyOpen}}" class="history-backdrop {{backdropMotion}}" catchtap="closeHistory">
      <view class="history-sheet {{sheetMotion}}" catchtap="noop" role="dialog" aria-modal="true" aria-label="健康记录">
        <scroll-view scroll-y enhanced show-scrollbar="{{false}}" class="history-sheet-scroll"><view class="history-sheet-body">
          <view class="sheet-handle"/><button class="sheet-close" bindtap="closeHistory" aria-label="关闭健康记录"><image src="{{icons.historyClose}}"/></button>
          <text class="eyebrow">PRIVATE HEALTH LOG</text><text class="heading">健康记录</text>
          <view class="history-sheet-content">
            <block wx:if="{{records.length}}">
              <view class="history-records"><view wx:for="{{records}}" wx:key="id" class="record">
                <text class="record-timestamp">{{item.date}} · {{item.timeLabel}} · {{item.sourceText}}</text><text class="record-summary">{{item.summary}}</text>
                <text wx:if="{{item.note}}" class="record-note">{{item.note}}</text><text wx:if="{{item.completedText}}" class="record-completed">已记录：{{item.completedText}}</text>
                <view class="record-actions"><button class="text-button" data-id="{{item.id}}" bindtap="editRecord"><image class="inline-icon" src="{{icons.edit}}"/>编辑</button><button class="text-button" bindtap="ask"><image class="inline-icon" src="{{icons.historyChat}}"/>带近期记录咨询</button><button class="text-button danger" data-id="{{item.id}}" aria-label="删除 {{item.date}} 的健康记录" bindtap="removeRecord" disabled="{{!canEdit}}"><image class="inline-icon" src="{{icons.historyDelete}}"/>删除</button></view>
              </view></view>
              <button class="text-button danger clear" bindtap="clearRecords" disabled="{{!canEdit}}"><image class="inline-icon" src="{{icons.historyDelete}}"/>清空全部健康记录</button>
            </block>
            <view wx:else class="history-empty"><image src="{{icons.historyClipboard}}"/><text>暂无健康记录</text><text>关闭本页后填写第一条睡眠或情绪记录。</text></view>
            <view class="history-disclaimer"><image src="{{icons.historyShield}}"/><text>游客记录保存在本机，微信登录后保存到账户；仅在你主动选择时向智能体发送摘要。</text></view>
          </view>
        </view></scroll-view>
      </view>
    </view>
  </block>
  <block wx:else>
  <view class="row range-heading"><view class="range"><button class="{{days === 7 ? 'active' : ''}}" data-days="7" bindtap="changeRange">近 7 天</button><button class="{{days === 30 ? 'active' : ''}}" data-days="30" bindtap="changeRange">近 30 天</button></view><button class="text-button" bindtap="focusEditor"><image class="inline-icon" src="{{icons.edit}}"/>填写记录</button></view>
  <view class="summary-grid"><view wx:for="{{summary}}" wx:key="label" class="summary-item"><text>{{item.label}}</text><text class="summary-number">{{item.number}}<text class="summary-unit">{{item.unit}}</text></text><text class="muted small">{{item.note}}</text></view></view>
  <view id="health-editor" class="card editor">
    <view class="row"><view><text class="eyebrow">DAILY CHECK-IN</text><text class="heading">{{editingId ? '编辑健康记录' : '填写健康记录'}}</text></view><button wx:if="{{editingId}}" class="text-button" bindtap="startNew"><image class="inline-icon" src="{{icons.plus}}"/>新填一条</button></view>
    <text class="help">{{editorHelp}}</text>
    <view class="field date-field"><text>记录日期</text><picker mode="date" value="{{draft.dateKey}}" end="{{today}}" bindchange="changeDate"><view class="picker-value date-picker-value">{{dateText.display(draft.dateKey)}}<view class="date-calendar" aria-hidden="true"/></view></picker><text wx:if="{{errors._date}}" class="error">{{errors._date}}</text></view>
    <view wx:if="{{sameDayId}}" class="merge-note"><text>这一天已有管理记录。再次填写将合并已填项，空项保留原值。</text><button class="text-button" bindtap="editRecord">载入并编辑当日记录</button></view>
    <text wx:if="{{completedText}}" class="help">原打卡内容保留：{{completedText}}</text>
    <view class="field-grid"><view wx:for="{{fields}}" wx:key="key" class="field"><text wx:if="{{item.showGroup}}" class="record-group">{{item.group}}</text><text>{{item.label}}</text><input wx:if="{{item.type === 'text'}}" type="text" value="{{draft.values[item.key]}}" data-key="{{item.key}}" bindinput="changeValue" maxlength="1000" disabled="{{!canEdit}}" placeholder="按实际情况填写"/><picker wx:elif="{{item.type === 'select'}}" range="{{item.choices}}" data-key="{{item.key}}" bindchange="changeSelect" disabled="{{!canEdit}}"><view class="picker-value">{{draft.values[item.key] || '未填写'}}<view class="select-caret"/></view></picker><picker wx:elif="{{item.key === 'menstrualStatus'}}" range="{{['未填写','不在经期','正在经期']}}" value="{{draft.values.menstrualStatus === '1' ? 2 : draft.values.menstrualStatus === '0' ? 1 : 0}}" bindchange="changeStatus"><view class="picker-value">{{draft.values.menstrualStatus === '1' ? '正在经期' : draft.values.menstrualStatus === '0' ? '不在经期' : '未填写'}}<view class="select-caret"/></view></picker><view wx:else class="number-field"><input class="{{errors[item.key] ? 'is-invalid' : ''}}" type="digit" value="{{draft.values[item.key]}}" data-key="{{item.key}}" bindinput="changeValue" placeholder-style="color:#9ca3af;" placeholder="未填写" maxlength="12" disabled="{{!canEdit}}"/><text>{{item.unit}}</text></view><text class="small {{errors[item.key] ? 'error' : 'muted'}}">{{errors[item.key] || item.hint || '按实际测量填写，未测量请留空'}}</text></view></view>
    <view class="note-field"><text>补充备注（选填）</text><textarea value="{{draft.note}}" bindinput="changeNote" maxlength="300" placeholder-style="color:#9ca3af;" placeholder="记录当日情况、检查时间或需要补充的信息" disabled="{{!canEdit}}"/><text class="counter">{{draft.note.length}} / 300</text></view>
    <text wx:if="{{error}}" class="error">{{error}}</text><button class="primary" hover-class="primary-pressed" hover-start-time="0" hover-stay-time="0" bindtap="saveRecord" disabled="{{!canEdit}}"><image class="inline-icon" src="{{icons.saveWhite}}"/>{{editingId ? '保存修改' : sameDayId ? '合并保存当日记录' : '保存记录'}}</button>
    <view class="privacy"><image class="inline-icon" src="/assets/icons/lock-health-specialty-private.png"/><text class="help small">{{storageNotice}}</text></view><text wx:if="{{notice}}" class="notice">{{notice}}</text>
    <button wx:if="{{tang && records.length}}" class="secondary" bindtap="ask">带着记录去问智能体 →</button>
  </view>
  <view class="card trends"><view class="row trends-heading"><view><text class="eyebrow">YOUR RECORDS</text><text class="heading">数值统计与趋势</text></view><image class="trends-heading-icon" src="{{icons.chartHeader}}"/></view><text class="help">每项均值按已填写的日期计算，同日取该项最近填写值。</text>
    <view class="metric-grid"><view wx:for="{{statsFields}}" wx:key="key" class="metric {{item.isStatus ? 'metric-status' : ''}}"><text class="metric-label">{{item.label}}</text><text class="muted small metric-unit">{{item.unit || '当日状态'}}</text><view class="row"><view><text class="muted small">{{item.key === 'menstrualStatus' ? '经期记录' : '均值'}}</text><text class="metric-value">{{item.averageText}}</text></view><view><text class="muted small">最近值</text><text class="metric-value">{{item.latestText}}</text></view></view><text class="muted small metric-note">近 {{days}} 天已填写 {{item.count}} 天</text></view></view>
    <view class="field"><text>查看趋势</text><picker range="{{trendFields}}" range-key="optionLabel" value="{{selectedIndex}}" bindchange="changeMetric"><view class="picker-value">{{selected.optionLabel}}<view class="select-caret"/></view></picker></view>
    <block wx:if="{{plot.hasData}}"><view class="trend-plot"><canvas type="2d" id="health-trend" class="trend-canvas {{plotImageReady ? 'trend-canvas-covered' : ''}}"/><image wx:if="{{plotImage}}" src="{{plotImage}}" data-src="{{plotImage}}" data-token="{{plotImageToken}}" mode="scaleToFill" class="trend-image {{plotImageReady ? '' : 'trend-image-loading'}}" bindload="plotImageLoad" binderror="plotImageError"/></view><text class="help">圆点表示实际填报值；未填写的日期留空、不连线。纵轴按本期实际数值显示。</text><button class="text-button trend-details-toggle" bindtap="toggleDetails"><text wx:if="{{tang}}">{{detailsOpen ? '▾' : '▸'}}</text><view wx:else class="trend-disclosure-marker {{detailsOpen ? 'is-open' : ''}}" aria-hidden="true"/>查看趋势明细</button><view wx:if="{{detailsOpen}}"><view wx:for="{{plot.plotPoints}}" wx:key="date" class="detail-row"><text>{{item.date}}</text><text>{{item.filled ? item.display : '未填写'}} {{item.filled && !tang ? selected.unit : ''}}</text></view></view></block>
    <view wx:else class="empty"><image class="empty-symbol" src="{{icons.chartEmpty}}"/><text class="empty-title">本期暂无{{selected.label}}数据</text><text class="muted small">填写后将显示实际趋势，未填写不会按 0 计算。</text></view>
  </view>
  <view class="card history"><button class="history-heading row" bindtap="toggleHistory"><view class="row"><image class="inline-icon" src="{{icons.historyClipboard}}"/><text>查看历史记录</text></view><view class="history-count"><text>{{records.length}} 条</text><text class="history-marker">{{historyOpen ? '−' : '+'}}</text></view></button><view wx:if="{{historyOpen}}">
    <view class="specialty-record-list"><view wx:for="{{records}}" wx:key="id" class="record"><view class="row"><text class="record-date">{{item.date}}</text><text class="record-source">{{item.sourceText}}</text></view>
      <view wx:if="{{item.measurementsList.length}}" class="record-measurements"><view wx:for="{{item.measurementsList}}" wx:for-item="metric" wx:key="label" class="record-measurement"><text>{{metric.label}}</text><text>{{metric.value}} {{metric.unit}}</text></view></view>
      <text wx:if="{{item.completedText}}" class="record-legacy">打卡：{{item.completedText}}</text><text wx:if="{{item.note}}" class="record-note">{{item.note}}</text><text wx:if="{{item.legacyEmpty}}" class="help">旧版健康记录，暂无补充数值。</text>
      <view class="record-actions"><button class="text-button" data-id="{{item.id}}" aria-label="编辑 {{item.date}} 的{{item.source === 'home' ? '首页' : '管理'}}记录" bindtap="editRecord"><image class="inline-icon" src="{{icons.edit}}"/>编辑</button><button class="text-button danger" data-id="{{item.id}}" aria-label="删除 {{item.date}} 的{{item.source === 'home' ? '首页' : '管理'}}记录" bindtap="removeRecord" disabled="{{!canEdit}}"><image class="inline-icon" src="{{icons.historyDelete}}"/>删除</button></view>
    </view></view>
    <button wx:if="{{records.length}}" class="text-button danger clear" bindtap="clearRecords" disabled="{{!canEdit}}"><image class="inline-icon" src="{{icons.historyDelete}}"/>清空当前智能体的{{storageLabel}}记录</button><view wx:else class="empty"><image class="empty-symbol" src="{{icons.emptyHistoryClipboard}}"/><text class="empty-title">还没有健康记录</text><text class="muted small">保存填报或首页打卡后，即可在这里查看和修改。</text></view>
  </view></view>
  </block>
</view>
