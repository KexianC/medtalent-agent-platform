<wxs module="dateText">
function display(value) { return value ? value.split('-').join('/') : ''; }
module.exports = { display: display };
</wxs>
<template name="history-delete"><view wx:if="{{pending}}" class="history-delete-confirm"><text>删除这条记录？</text><button data-id="{{id}}" data-kind="{{kind}}" bindtap="confirmHistoryDelete" disabled="{{!canEdit}}">确认删除</button><button data-id="{{id}}" bindtap="cancelHistoryDelete">取消</button></view><button wx:else class="history-delete-button" data-id="{{id}}" bindtap="requestHistoryDelete" disabled="{{!canEdit}}"><image src="/assets/icons/delete-wellness-history.png"/></button></template>
<template name="record-editor"><view class="record-editor"><view class="record-intro"><text class="eyebrow">{{mode === 'diary' ? 'SLEEP & FEELINGS' : 'MY HEALTH LOG'}}</text><text class="heading">{{mode === 'diary' ? '睡眠情绪日记' : '健康数据记录'}}</text><text class="muted">{{mode === 'diary' ? '不必急着改变感受，先把今天的自己温柔地记下来。' : '积累属于自己的日常数据，让变化有迹可循。'}}</text></view><view class="row date-row"><view class="field grow"><text>记录日期</text><picker mode="date" start="1900-01-01" end="{{today}}" value="{{date}}" bindchange="changeDate"><view class="picker-value">{{dateText.display(date)}}<view class="date-calendar" aria-hidden="true"/></view></picker></view><button class="text-button" bindtap="todayDraft" disabled="{{date === today}}">回到今天</button></view><view class="record-form"><view class="row"><text class="subheading">{{existing ? '编辑这一天的记录' : date === today ? '记录今天' : '补记这一天'}}</text><text class="small muted">全部选填</text></view>
        <view class="field-grid"><view wx:for="{{metrics}}" wx:key="key" class="field"><text>{{item.label}}</text><view class="number-field"><input value="{{draft.values[item.key]}}" type="digit" data-key="{{item.key}}" bindinput="metricInput" placeholder="未记录" placeholder-class="record-number-placeholder" maxlength="12" disabled="{{!canEdit}}"/><text>{{item.unit}}</text></view><text wx:if="{{item.hint}}" class="small muted">{{item.hint}}</text></view></view>
        <view wx:if="{{mode === 'diary'}}" class="record-writing"><view wx:for="{{writingFields}}" wx:key="key" class="field"><text>{{item.label}}</text><textarea value="{{draft[item.key]}}" data-key="{{item.key}}" bindinput="writingInput" placeholder="{{item.placeholder}}" placeholder-class="record-writing-placeholder" maxlength="600" disabled="{{!canEdit}}"/><text class="counter">{{draft[item.key].length}} / 600</text></view></view><text wx:else class="help">按实际测量或设备显示手动填写。睡眠和心情可在“睡眠情绪日记”中记录，两处按日期合并。</text>
        <text wx:if="{{error}}" class="error">{{error}}</text><text wx:if="{{notice}}" class="notice">{{notice}}</text><button class="primary" bindtap="saveRecord" disabled="{{!canEdit}}">{{existing ? '保存修改' : '保存记录'}}</button><text class="help">同一天只保留一份记录，修改此表单会保留另一表单已填写的内容；留空表示未记录。</text><button wx:if="{{existing && !deleteConfirm}}" class="text-button record-delete" bindtap="deleteDay" disabled="{{!canEdit}}">删除这天全部记录</button><view wx:if="{{deleteConfirm}}" class="record-confirm"><text>删除 {{date}} 的日记和健康数据？删除后无法恢复。</text><view class="actions"><button class="secondary" bindtap="cancelDeleteDay">保留记录</button><button class="text-button record-delete" bindtap="confirmDeleteDay" disabled="{{!canEdit}}">确认删除</button></view></view>
      </view><text class="record-footnote">{{accountUser ? '记录会同步到微信账户，完成后可跨设备查看。' : '记录仅保存在当前设备。'}}用于自我观察与沟通，不作诊断依据。</text></view></template>
<template name="record-detail"><view wx:if="{{record}}" class="record-detail"><view wx:for="{{record.fields}}" wx:key="label" class="detail-row"><text class="muted">{{item.label}}</text><text>{{item.value}} <text class="detail-unit">{{item.unit}}</text></text></view><view wx:for="{{record.writing}}" wx:key="label" class="writing-detail"><text class="bold">{{item.label}}</text><text>{{item.value}}</text></view></view><text wx:else class="empty-text">这一天还没有记录。未填写的内容不会按 0 计算。</text></template>
<view class="wellness {{section === 'home' ? 'wellness-home' : 'wellness-workspace'}}">
  <view wx:if="{{section !== 'home'}}" class="intro"><text class="eyebrow">{{section === 'manage' ? 'MY HEALTH JOURNAL' : 'MIND & DISCOVERY'}}</text><text class="title">{{activeFeature ? activeFeature.title : section === 'manage' ? '我的健康管理' : '身心练习与探索'}}</text><text class="description">{{activeFeature ? activeFeature.description : section === 'manage' ? '把每天的记录，连成自己的健康轨迹。' : '选择适合此刻的方式，与自己相处一会儿。'}}</text></view>
  <view wx:if="{{storageNotice}}" class="storage-notice"><text>{{storageNotice}}</text><button wx:if="{{storageCanRetry}}" bindtap="retryStorage" disabled="{{storageRetrying}}">{{storageRetrying ? '正在重试…' : storageRetryLabel}}</button></view>
  <view wx:if="{{practiceSavePending}}" class="storage-notice" role="alert"><text>{{practiceSavePending}} 条练习尚未保存，暂时保留在当前页面。请重试保存后再离开。</text><button bindtap="retryPracticeSave" disabled="{{!canEdit}}">重试保存练习</button></view>
  <block wx:if="{{!activeView}}">
    <view wx:if="{{section === 'home'}}" class="card home-journal"><text class="eyebrow">A MOMENT FOR YOURSELF</text><text class="heading">今天，过得怎么样？</text><text class="muted">慢一点，记录睡眠，也听一听自己的心情。</text><view class="home-stats"><view><text class="number">{{homeStats.count}}<text class="small"> / 7</text></text><text class="small muted">近七日记录天数</text></view><view><text class="number">{{homeStats.average}}<text wx:if="{{homeStats.hasMood}}" class="small"> / 10</text></text><text class="small muted">{{homeStats.hasMood ? '近七日平均心情' : '等待第一份心情记录'}}</text></view></view><button class="primary" data-view="diary" bindtap="open">{{homeStats.hasToday ? '继续记录今天' : '写下今日感受'}} →</button><button class="text-button" data-view="report" bindtap="open">查看我的趋势报告</button></view>
    <view class="feature-grid"><button wx:for="{{visibleFeatures}}" wx:key="id" class="feature" data-view="{{item.id}}" bindtap="open"><view class="feature-symbol"><image class="feature-icon" src="{{item.iconUrl}}"/></view><text class="feature-title">{{item.title}}</text><text class="small muted">{{item.description}}</text><image class="feature-arrow" src="{{icons.featureArrow}}"/></button></view>
    <view wx:if="{{section === 'services'}}" class="card qa-card"><text class="heading">需要进一步聊一聊？</text><text class="muted">可以把想了解的问题写下来，由喻雯智能体帮你梳理。</text><button class="primary" bindtap="ask">进入健康问答</button></view>
    <view wx:if="{{section === 'manage'}}" class="record-history"><view class="row"><text class="heading">我的记录</text><text class="small muted">{{recordCount}} 天</text></view><text wx:if="{{!recordCount}}" class="empty-text">还没有记录。从今天的一项感受或一个数值开始就好。</text><view wx:for="{{records}}" wx:key="id" class="history-item"><button class="history-open row" data-date="{{item.date}}" bindtap="selectHistory"><view><text class="bold">{{item.date}}</text><text class="small muted">{{item.summary}}{{item.writing.length ? ' · 有日记' : ''}}</text></view><text class="small">{{selectedDate === item.date ? '收起' : '查看'}}</text></button><view wx:if="{{selectedDate === item.date}}" class="record-history-expanded"><template is="record-detail" data="{{record:selectedRecord}}"/><view class="actions"><button class="secondary" data-mode="diary" bindtap="editHistory">编辑日记</button><button class="secondary" data-mode="health" bindtap="editHistory">编辑健康数据</button><button wx:if="{{inlineRecordMode}}" class="secondary" bindtap="closeHistoryEditor">收起编辑</button></view><template wx:if="{{inlineRecordMode}}" is="record-editor" data="{{mode:recordMode,draft:draft,metrics:metrics,writingFields:writingFields,date:date,today:today,existing:existing,error:error,notice:notice,accountUser:accountUser,canEdit:canEdit,deleteConfirm:deleteConfirm}}"/></view></view><button wx:if="{{recordCount > records.length}}" class="secondary" bindtap="moreRecords">查看更多记录</button></view>
  </block>
  <block wx:else>
    <button class="back text-button" bindtap="back"><image class="inline-icon wellness-back-icon" src="{{icons.back}}"/>返回{{section === 'manage' ? '管理' : '身心空间'}}</button>
    <template wx:if="{{activeView === 'diary' || activeView === 'health'}}" is="record-editor" data="{{mode:recordMode,draft:draft,metrics:metrics,writingFields:writingFields,date:date,today:today,existing:existing,error:error,notice:notice,accountUser:accountUser,canEdit:canEdit,deleteConfirm:deleteConfirm}}"/>
    <block wx:if="{{activeView === 'report'}}">
      <view class="record-report"><view class="record-intro"><text class="eyebrow">GENTLE REFLECTION</text><text class="heading">我的健康趋势</text><text class="muted">看看真实记录里的变化，也允许有空白的日子。</text></view><view class="range report-range"><button data-days="7" class="{{days === 7 ? 'active' : ''}}" bindtap="changeRange">近 7 天</button><button data-days="30" class="{{days === 30 ? 'active' : ''}}" bindtap="changeRange">近 30 天</button></view><view class="report-summary"><view><text>有记录的日子</text><text class="number">{{reportCount}} <text class="small">/ {{days}} 天</text></text></view><text class="small muted">{{reportStart}} — {{today}}
每项平均值只计算该项实际填写的天数。</text></view><text wx:if="{{!reportCount}}" class="empty-text">这段时间还没有记录。完成日记或健康数据后，这里会按真实数据生成统计。</text><view wx:if="{{statistics.length}}" class="statistics"><button wx:for="{{statistics}}" wx:key="key" class="statistic {{reportMetric.key === item.key ? 'selected' : ''}}" data-key="{{item.key}}" bindtap="reportStat"><text class="small muted">平均{{item.label}}</text><text class="statistic-number">{{item.averageText}}<text class="small"> {{item.unit}}</text></text><text class="small muted">{{item.count}} 天有填写</text></button></view>
        <view class="report-chart-card"><view class="field"><text>查看指标趋势</text><picker range="{{metricsAll}}" range-key="label" value="{{metricIndex}}" bindchange="reportMetric"><view class="picker-value"><text>{{reportMetric.label}}</text><view class="picker-arrow"/></view></picker></view><view class="row chart-meta"><text class="bold">{{reportMetric.label}}</text><text class="small muted">{{reportMetric.unit}} · {{reportMetricCount}} 天有填写</text></view><text wx:if="{{reportMetric.hint}}" class="help">{{reportMetric.hint}}</text><scroll-view scroll-x class="chart-scroll"><view class="chart-pad"><view class="bar-chart {{days === 30 ? 'is-month' : ''}}"><button wx:for="{{chart}}" wx:key="date" class="bar-item {{reportDate === item.date ? 'selected' : ''}} {{item.filled ? '' : 'is-empty'}}" data-date="{{item.date}}" bindtap="selectReportDate"><text class="bar-value">{{item.valueText}}</text><view class="bar-track"><view wx:if="{{item.filled}}" class="bar-fill" style="height:{{item.percent}}%;min-height:{{item.percent === 0 ? 3 : 0}}px;"></view></view><text class="bar-date">{{item.label}}</text></button></view></view></scroll-view><text class="help">横向可查看全部日期，点击某天查看明细。— 表示未记录。</text></view>
      </view><view class="report-day-detail"><text class="subheading">{{reportDate}} 记录明细</text><template is="record-detail" data="{{record:reportRecord}}"/></view><view class="report-association association"><text class="subheading">生活习惯与心情</text><view class="field"><text>对照指标</text><picker range="{{associationOptions}}" range-key="label" value="{{associationIndex}}" bindchange="changeAssociation"><view class="picker-value"><text>{{associationOptions[associationIndex].label}}</text><view class="picker-arrow"/></view></picker></view><text>{{associationText}}</text><text class="help">仅描述这段记录中的关联，不代表因果或健康结论；样本较少时结果可能不稳定。</text></view>
    </block>
    <block wx:if="{{activeView === 'goals'}}">
      <view class="card goal-summary"><text class="eyebrow">ONE SMALL STEP</text><text class="heading">给今天一个小目标</text><text class="muted">目标由你设定。实际记录会显示进度，完成后由你确认打卡。</text><text class="number">{{goalCompleted}} <text class="small">/ {{goals.length}} 项已打卡</text></text><text class="small muted">{{today}}</text></view><button class="primary" bindtap="startGoal" disabled="{{!canEdit}}"><image class="inline-icon" src="{{icons.plusWhite}}"/>添加每日目标</button><text wx:if="{{notice}}" class="notice">{{notice}}</text>
      <view wx:if="{{goalEditor}}" class="card goal-editor"><text class="subheading">{{goalEditing ? '编辑目标' : '设置每日目标'}}</text><view class="field"><text>目标类型</text><picker range="{{goalKinds}}" range-key="title" value="{{goalKindIndex}}" bindchange="changeGoalKind"><view class="picker-value"><text>{{goalKinds[goalKindIndex].title}}</text><view class="picker-arrow"/></view></picker></view><view class="field"><text>目标名称</text><input value="{{goalTitle}}" data-key="goalTitle" bindinput="goalInput" maxlength="40" class="plain-input"/></view><view class="field"><text>每日数量（{{goalKinds[goalKindIndex].unit}}）</text><input value="{{goalTarget}}" data-key="goalTarget" bindinput="goalInput" type="digit" class="plain-input"/></view><text wx:if="{{error}}" class="error">{{error}}</text><view class="actions"><button class="primary" bindtap="saveGoal">保存目标</button><button class="secondary" bindtap="cancelGoal">取消</button></view></view>
      <view wx:if="{{!goals.length}}" class="empty"><image class="empty-symbol" src="{{icons.goalEmpty}}"/><text class="subheading">从一件小事开始</text><text class="muted">试着设定“写一篇日记”或“冥想放松”，按自己的节奏完成。</text></view><view wx:for="{{goals}}" wx:key="id" class="card goal {{item.done ? 'done' : ''}}"><view class="row"><text class="subheading">{{item.title}}</text><button class="goal-icon" data-id="{{item.id}}" bindtap="startGoal" aria-label="{{'编辑' + item.title}}" aria-role="button"><image src="{{icons.goalEdit}}"/></button></view><text class="muted">每日 {{item.target}} {{item.unit}}</text><block wx:if="{{item.kind !== 'custom'}}"><progress percent="{{item.percent}}" stroke-width="7" activeColor="{{accentColor}}" backgroundColor="#eee9f5"/><text class="small muted">今日已记录 {{item.progress}} {{item.unit}}</text></block><view class="actions"><button class="{{item.done ? 'secondary active' : 'primary'}}" data-id="{{item.id}}" bindtap="checkGoal" disabled="{{!canEdit}}"><image class="inline-icon" src="{{item.done ? icons.checkFill : icons.checkWhite}}"/>{{item.done ? '已打卡 · 撤销' : '完成打卡'}}</button><button class="goal-icon" data-id="{{item.id}}" bindtap="deleteGoal" disabled="{{!canEdit}}" aria-label="{{'删除' + item.title}}" aria-role="button"><image src="/assets/icons/delete-wellness-goal.png"/></button></view></view><view wx:if="{{checkHistory.length}}" class="card goal-history"><text class="subheading">最近打卡</text><view class="goal-history-list"><view wx:for="{{checkHistory}}" wx:key="key" class="detail-row"><text>{{item.title}}</text><text class="muted">{{item.date}}</text></view></view></view>
    </block>
    <view wx:if="{{activeView === 'assessment' || activeView === 'mbti'}}" class="assessment-workspace"><view class="assessment-heading"><image src="{{activeView === 'assessment' ? '/assets/icons/wellness-clipboard-list.png' : '/assets/icons/wellness-sparkles-strong.png'}}"/><view><text class="assessment-title">{{activeView === 'assessment' ? '心理自评' : 'MBTI 趣味探索'}}</text><text class="assessment-caption">{{activeView === 'assessment' ? '用一份记录，了解近两周的自己' : '认识偏好，也给变化留一点空间'}}</text></view></view>
      <native-questionnaire variant="wellness" wx:if="{{questionnaire}}" title="{{questionnaire.title}}" description="{{questionnaire.description}}" questions="{{questionnaire.questions}}" accent-color="{{accentStrong}}" bind:complete="finishQuiz" bind:close="closeQuiz"/>
      <block wx:else>
        <block wx:if="{{activeView === 'assessment'}}">
          <view wx:if="{{assessmentResult}}" class="card assessment-result"><text class="eyebrow">本次自评 · {{assessmentResult.displayDate}}</text><text class="heading">{{assessmentResult.title}}</text><view class="assessment-score"><text>{{assessmentResult.score}}</text><text>/ {{assessmentResult.maxScore}} 分</text></view><text class="subheading result-label">{{assessmentResult.description.label}}</text><text class="result-copy">{{assessmentResult.description.text}}</text><text class="comparison">{{assessmentResult.comparison}}</text><view class="assessment-details"><button class="disclosure-toggle text-button assessment-detail-summary" bindtap="toggleAnswers" aria-expanded="{{answerDetails}}"><view class="disclosure-marker {{answerDetails ? 'is-open' : ''}}" aria-hidden="true"/>查看本次回答与计分说明</button><block wx:if="{{answerDetails}}"><view class="assessment-answer-list"><view wx:for="{{assessmentResult.answerItems}}" wx:key="question" class="answer-detail"><text>{{item.question}}</text><text class="bold">{{item.answer}} · {{item.scoreText}}</text></view></view><text class="assessment-scoring">{{assessmentResult.scoringText}}</text></block></view><button class="secondary" bindtap="repeatAssessment"><image class="assessment-action-icon" src="/assets/icons/wellness-repeat-strong.png"/>重新自评</button></view>
          <view class="card"><text class="assessment-intro muted">面向 18 岁及以上成人的自我记录。自评只提供筛查参考，不能代替专业诊断或治疗，也不能用于判断是否需要自行调整药物。若困扰持续或影响生活，可与专业人员讨论。</text><checkbox-group bindchange="setConsent"><label class="consent"><view class="consent-box {{consent ? 'checked' : ''}}"><checkbox value="consent" checked="{{consent}}" color="#805ca5"/><view class="consent-mark" aria-hidden="true"/></view><text>我已满 18 岁，了解上述说明，并同意{{accountUser ? '将本次自评记录保存到微信账户' : '在当前设备保存本次自评记录'}}。</text></label></checkbox-group><text wx:if="{{error}}" class="error">{{error}}</text><view wx:for="{{scales}}" wx:key="id" class="scale-card"><view class="scale-copy"><text class="subheading">{{item.title}}</text><text class="scale-subtitle">{{item.subtitle}}</text><text class="scale-caption">{{item.duration}} · {{item.scoredItems}} 道计分题{{item.id === 'gad7' ? ' + 1 道补充题' : ''}}</text></view><button class="primary" data-id="{{item.id}}" bindtap="startAssessment" disabled="{{!canEdit}}">开始自评<image class="assessment-action-icon" src="/assets/icons/guidance-arrow-white.png"/></button></view></view>
          <view class="card"><view class="row"><text class="subheading">自评历史</text><picker range="{{assessmentFilters}}" value="{{assessmentFilter}}" bindchange="filterAssessment"><view class="filter">{{assessmentFilters[assessmentFilter]}}<view class="assessment-filter-arrow" aria-hidden="true"/></view></picker></view><text wx:if="{{!assessmentHistory.length}}" class="empty-text assessment-empty">还没有{{assessmentFilter === 0 ? '' : assessmentFilter === 1 ? ' GAD7 ' : ' PHQ2 '}}自评记录。完成后可查看得分与历史对比。</text><view wx:if="{{assessmentHistory.length}}" class="assessment-history-list"><view wx:for="{{assessmentHistory}}" wx:key="id" class="history-row"><button class="history-open" data-id="{{item.id}}" bindtap="selectAssessment"><text class="bold">{{item.title}}</text><text class="small muted">{{item.displayDate}} · {{item.score}} / {{item.maxScore}} 分</text><text class="small muted">查看回答与对比</text></button><template is="history-delete" data="{{id:item.id,kind:'assessments',pending:historyDeleteIds[item.id],canEdit:canEdit}}"/></view></view><button wx:if="{{filteredAssessmentCount > 8}}" class="text-button history-more" data-key="allAssessmentHistory" bindtap="toggleHistory">{{allAssessmentHistory ? '收起记录' : '查看全部 ' + filteredAssessmentCount + ' 条记录'}}</button></view>
          
        </block>
        <block wx:if="{{activeView === 'mbti'}}"><view class="card personality-intro"><text class="subheading">20 个生活里的小选择</text><text class="personality-copy">从精力来源、关注信息、做决定和安排生活四个角度，看看此刻的自己更接近哪一种偏好。</text><text class="help">自编题目，仅作 MBTI 风格趣味探索，未经心理测量验证，不属于正式 MBTI 测评。约 3–5 分钟，完成后{{accountUser ? '将结果同步到微信账户' : '在当前设备保存结果'}}。</text><button class="primary" bindtap="startPersonality" disabled="{{!canEdit}}"><image class="assessment-action-icon" src="{{personalityCount ? '/assets/icons/wellness-repeat-white.png' : '/assets/icons/wellness-sparkles-white-16.png'}}"/>{{personalityCount ? '重新探索' : '开始探索'}}</button></view><view wx:if="{{personalityResult}}" class="card personality-result"><text class="eyebrow">本次偏好 · {{personalityResult.displayDate}}</text><text class="personality-type">{{personalityResult.type}}</text><text class="heading">{{personalityResult.description.title}}</text><text class="personality-copy">{{personalityResult.description.description}}</text><view class="personality-dimensions"><view wx:for="{{personalityResult.dimensionsList}}" wx:key="key" class="dimension"><text class="bold small">{{item.title}}</text><view class="row"><text>{{item.first}} {{item.firstLabel}} {{item.firstPercent}}%</text><text>{{item.secondPercent}}% {{item.secondLabel}} {{item.second}}</text></view><view class="dimension-track"><view style="width:{{item.firstPercent}}%;"></view></view></view></view><text class="help">百分比表示本次 5 道相关题目中两侧选项的占比，不是人格强度或心理测量常模。</text><text class="comparison">一个小练习：{{personalityResult.description.practice}}</text><text class="help">自编题目，仅作 MBTI 风格的趣味偏好探索；未经心理测量验证，不属于正式 MBTI 测评。偏好会随情境变化，不用于诊疗、择业或给自己和他人定型。</text></view><view class="card"><text class="subheading">探索历史</text><text wx:if="{{!personalityHistory.length}}" class="empty-text leisure-empty">完成问答后，会在这里留下属于你的偏好记录。</text><view wx:if="{{personalityHistory.length}}" class="assessment-history-list"><view wx:for="{{personalityHistory}}" wx:key="id" class="history-row"><button class="history-open" data-id="{{item.id}}" bindtap="selectPersonality"><text class="bold">{{item.type}} · {{item.title}}</text><text class="small muted">{{item.displayDate}}</text></button><template is="history-delete" data="{{id:item.id,kind:'personalities',pending:historyDeleteIds[item.id],canEdit:canEdit}}"/></view></view><button wx:if="{{personalityCount > 8}}" class="text-button history-more" data-key="allPersonalityHistory" bindtap="toggleHistory">{{allPersonalityHistory ? '收起记录' : '查看全部 ' + personalityCount + ' 条记录'}}</button></view><view class="source personality-types"><button class="disclosure-toggle text-button" data-key="showTypes" bindtap="toggleHistory" aria-expanded="{{showTypes}}"><view class="disclosure-marker {{showTypes ? 'is-open' : ''}}" aria-hidden="true"/>看看全部 16 种偏好</button><view wx:if="{{showTypes}}"><view wx:for="{{personalityTypes}}" wx:key="type" class="answer-detail"><button class="disclosure-toggle text-button type-heading" data-type="{{item.type}}" bindtap="togglePersonalityType" aria-expanded="{{item.expanded}}"><view class="disclosure-marker {{item.expanded ? 'is-open' : ''}}" aria-hidden="true"/>{{item.type}} · {{item.title}}</button><text wx:if="{{item.expanded}}" class="small muted">{{item.description}}</text></view></view></view></block>
      </block>
      <view wx:if="{{activeView === 'assessment'}}" class="source"><button class="disclosure-toggle text-button" data-key="assessmentSourceOpen" bindtap="toggleHistory" aria-expanded="{{assessmentSourceOpen}}"><view class="disclosure-marker {{assessmentSourceOpen ? 'is-open' : ''}}" aria-hidden="true"/>量表来源与使用说明</button><view wx:if="{{assessmentSourceOpen}}" class="assessment-source-body"><text class="small source-paragraph">GAD-7 与 PHQ 由 Robert L. Spitzer、Janet B.W. Williams、Kurt Kroenke 等开发，获 Pfizer 教育资助。PHQ-2 取 PHQ-9 前两题。</text><text class="small source-paragraph">简体中文题干：Fu KY、Yap AU、Lei J、Liu MQ、Fan XF 译，INfORM 中文评价工具第 50、52 页。原页面注明可免费复制、翻译、展示与分发。</text><view class="assessment-source-links"><button class="text-button" data-source="original" bindtap="copySource"><text>查看简体中文原文</text></button><button class="text-button" data-source="manual" bindtap="copySource"><text>查看 Pfizer 计分手册</text></button></view><text class="small source-paragraph">分数只与同一量表比较；不同量表的得分不能直接比较。当前页面不会向医生发送结果。</text><text wx:if="{{sourceError}}" class="form-error">{{sourceError}}</text></view></view>
    </view>
    <view wx:if="{{activeView === 'cards'}}" class="assessment-workspace cards-workspace"><view class="assessment-heading"><image src="/assets/icons/wellness-sparkles-strong.png"/><view><text class="assessment-title">趣味抽卡</text><text class="assessment-caption">翻开一张卡，留一个温柔的小思考</text></view></view><text class="card-notice">8 张象征卡，每次随机抽取，带来一个日常反思的小提示。仅供娱乐，不用于预测未来、健康或作出重要决定。</text><view class="card-stage"><text class="card-symbol">{{currentCard ? currentCard.symbol : '✧'}}</text><text wx:if="{{currentCard}}" class="eyebrow">你翻开的象征卡</text><text class="heading">{{currentCard ? currentCard.name : '为此刻留一点空间'}}</text><text wx:if="{{currentCard}}" class="subheading">{{currentCard.theme}}</text><text>{{currentCard ? currentCard.text : '8 张卡，8 个日常思考的方向。\n没有吉凶，也没有命定的答案。'}}</text><text wx:if="{{currentCard}}" class="card-action">{{currentCard.action}}</text><button class="primary" bindtap="drawCard" disabled="{{!canEdit}}"><image class="assessment-action-icon card-draw-icon" src="/assets/icons/wellness-sparkles-white-17.png"/>{{currentCard ? '再抽一张' : '翻开一张卡'}}</button><text class="small muted">每张卡机会相同 · 可能重复抽到</text></view><view class="card"><text class="subheading">抽卡记录</text><text wx:if="{{!cardHistory.length}}" class="empty-text leisure-empty">翻开的卡会{{accountUser ? '同步到微信账户，完成后可跨设备查看' : '保存在当前设备，随时可以回来看看'}}。</text><view wx:if="{{cardHistory.length}}" class="assessment-history-list"><view wx:for="{{cardHistory}}" wx:key="id" class="history-row"><button class="history-open" data-id="{{item.id}}" bindtap="selectCard"><text class="bold">{{item.card.name}} · {{item.card.theme}}</text><text class="small muted">{{item.displayDate}}</text></button><template is="history-delete" data="{{id:item.id,kind:'cardDraws',pending:historyDeleteIds[item.id],canEdit:canEdit}}"/></view></view><button wx:if="{{cardCount > 8}}" class="text-button history-more" data-key="allCardHistory" bindtap="toggleHistory">{{allCardHistory ? '收起记录' : '查看全部 ' + cardCount + ' 条记录'}}</button></view></view>
    <block wx:if="{{activeView === 'breathing'}}"><view class="card breathing-card"><text class="eyebrow">BREATHE AT YOUR PACE</text><text class="heading">跟着节奏，慢慢放松</text><text class="muted">选择舒适的节奏，保持自然呼吸。停顿是可选的，任何时候都可以暂停或停止。</text><view class="breathing-fields"><view class="field"><text>呼吸节奏</text><picker range="{{breathHoldOptions}}" value="{{breathHoldIndex}}" data-key="breathHoldIndex" bindchange="breathingSetting" disabled="{{breathInProgress}}"><view class="picker-value {{breathInProgress ? 'is-disabled' : ''}}"><text>{{breathHoldOptions[breathHoldIndex]}}</text><view class="breathing-picker-arrow"/></view></picker></view><view class="field"><text>练习时长</text><picker range="{{breathDurationOptions}}" value="{{breathDurationIndex}}" data-key="breathDurationIndex" bindchange="breathingSetting" disabled="{{breathInProgress}}"><view class="picker-value {{breathInProgress ? 'is-disabled' : ''}}"><text>{{breathDurationOptions[breathDurationIndex]}}</text><view class="breathing-picker-arrow"/></view></picker></view></view><view class="breathing-stage"><view class="breath-orbit" style="transform:scale({{breathScale}});transition-duration:{{breathPhase === '呼气' ? 6 : 4}}s;"></view><view class="breath-label"><image class="breath-symbol" src="/assets/icons/wind-wellness-regular.png"/><text class="bold">{{breathPhase}}</text><text class="number">{{breathCountdown}}</text></view></view><text class="center muted">已练习 {{breathElapsed}} / {{breathTotal}}</text><view class="actions"><button class="primary" bindtap="toggleBreathing" disabled="{{!canEdit}}"><image class="inline-icon breathing-primary-icon" src="{{breathRunning ? icons.pauseWhite : icons.playWhite}}"/>{{breathRunning ? '暂停练习' : breathInProgress ? '继续练习' : '开始练习'}}</button><button wx:if="{{breathInProgress}}" class="secondary" bindtap="endBreathing"><image class="inline-icon practice-stop-icon" src="{{icons.stop}}"/>结束</button></view><text wx:if="{{notice}}" class="notice">{{notice}}</text></view></block>
    <block wx:if="{{activeView === 'meditation'}}"><view class="course-chips"><view><button wx:for="{{courseCategories}}" wx:key="*this" class="chip {{courseFilter === item ? 'active' : ''}}" data-category="{{item}}" bindtap="filterCourses">{{item}}</button></view></view><view class="course-list"><button wx:for="{{visibleCourses}}" wx:key="id" data-id="{{item.id}}" class="course {{course.id === item.id ? 'selected' : ''}}" bindtap="selectCourse"><view class="course-symbol"><image src="{{icons.courseHeadphones}}"/></view><view><text class="bold">{{item.title}}</text><text class="small muted">{{item.category}} · {{item.durationText}}</text></view><image class="course-play" src="{{icons.coursePlay}}"/></button></view><view class="card player"><view class="player-art"><image src="{{icons.playerHeadphones}}"/><text class="small">合成语音引导</text></view><text class="subheading">{{course.title}}</text><text class="muted">{{course.description}}</text><view class="audio-progress"><text>播放进度</text><view class="audio-range"><view class="audio-range-track"><view class="audio-range-base"/><view class="audio-range-fill" style="width:{{position / course.seconds * 100}}%;"/></view><slider class="audio-range-control" min="0" max="{{course.seconds}}" step="1" value="{{position}}" activeColor="transparent" backgroundColor="transparent" block-color="{{accentColor}}" block-size="15" bindchanging="seekAudio" bindchange="seekAudio"/></view></view><view class="row player-time-row"><text>{{positionText}}</text><text>{{courseTotal}}</text></view><view class="actions"><button class="primary" bindtap="toggleAudio" disabled="{{!canEdit}}"><image class="inline-icon player-primary-icon" src="{{playing ? icons.pauseWhite : icons.playWhite}}"/>{{playing ? '暂停播放' : '播放引导'}}</button><button class="secondary" bindtap="endAudio" disabled="{{!audioCanFinish}}"><image class="inline-icon practice-stop-icon" src="{{icons.stop}}"/>结束练习</button></view><text wx:if="{{error}}" class="error">{{error}}</text><text wx:if="{{notice}}" class="notice">{{notice}}</text><button class="disclosure-toggle text-button" bindtap="toggleTranscript" aria-expanded="{{transcriptOpen}}"><view class="disclosure-marker {{transcriptOpen ? 'is-open' : ''}}" aria-hidden="true"/>阅读完整引导文字</button><text wx:if="{{transcriptOpen}}" class="transcript">{{course.transcript}}</text><text class="help">原创练习 · 合成语音，非喻雯本人录音。请在安全、安静的环境中使用，可随时停止。拖动进度不会计入练习时长。</text></view></block>
    <view wx:if="{{activeView === 'breathing' || activeView === 'meditation'}}" class="card practice-history"><text class="subheading">我的练习记录</text><text wx:if="{{!practiceHistory.length}}" class="empty-text">完成一次练习后，在这里回看实际练习时长。</text><view wx:for="{{practiceHistory}}" wx:key="id" class="practice-record"><text class="bold">{{item.title}}</text><text class="small muted">{{item.displayDate}} · {{item.displayTime}} · {{item.completed ? '已完成' : '本次练习'}}</text><button class="text-button danger" data-id="{{item.id}}" data-kind="sessions" bindtap="deleteHistory">删除记录</button></view></view>
    <text wx:if="{{activeView === 'breathing'}}" class="footnote breathing-footnote">离开练习页面会结束本次练习；切到后台会暂停计时。当前累计 {{practiceHistoryCount}} 次练习。</text>
  </block>
  <text class="footnote">{{accountUser ? '记录会同步到微信账户，完成后可跨设备查看；在历史中删除的记录也会同步删除。' : '记录保存在当前设备的游客空间，可在各项历史中删除。'}}自评与趣味探索不作为诊断依据。</text>
</view>
