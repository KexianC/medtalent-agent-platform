.assessment-source-links>.text-button>text{text-decoration:underline}

.consent-box{position:relative;width:18px;height:18px;flex:0 0 18px;margin-top:2px}.assessment-workspace .consent-box checkbox{position:absolute;inset:0;margin:0;opacity:0}.consent-mark{position:absolute;inset:0;box-sizing:border-box;border:1px solid #767676;border-radius:2px;background:#fff;pointer-events:none}

.assessment-workspace .scale-card>.primary{gap:7px}


.wellness .wellness-back-icon{width:16px;height:16px;margin-right:6px}
.wellness .assessment-action-icon{width:16px;height:16px;flex:none;margin:0;vertical-align:middle}
.card-stage .card-draw-icon{width:17px;height:17px}
.assessment-result>.secondary,.personality-intro>.primary,.card-stage>.primary{gap:7px}
.breathing-card .breathing-primary-icon{width:19px;height:19px;margin:0}
.player .player-primary-icon{width:20px;height:20px;margin:0}
.wellness .practice-stop-icon{width:18px;height:18px;margin-right:6px}

.breathing-fields .picker-value>text{position:relative;left:4px;top:1px}

.consent-box.checked .consent-mark{background:#805ca5;border-color:#805ca5}.consent-box.checked .consent-mark:after{content:"";position:absolute;left:-1px;top:-1px;display:block;width:18px;height:18px;background:url("data:image/svg+xml;charset=utf8,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%2218%22%20height%3D%2218%22%20viewBox%3D%220%200%2018%2018%22%3E%3Cpath%20d%3D%22M3.6%209%207.2%2012.6%2014.4%203.6%22%20fill%3D%22none%22%20stroke%3D%22%23fff%22%20stroke-width%3D%222.88%22%20stroke-linecap%3D%22butt%22%20stroke-linejoin%3D%22miter%22%2F%3E%3C%2Fsvg%3E") no-repeat center;background-size:18px 18px}
