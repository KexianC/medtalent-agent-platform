@import "utils/sheet-motion.wxss";
page { height:100%; background:#f8f9f6; color:#143c38; font-family:Inter,"PingFang SC","Microsoft YaHei",system-ui,sans-serif; font-synthesis:none; font-size:16px; line-height:1.5; --journey-accent:#2f8f65; --journey-accent-strong:#1c684a; --journey-accent-rgb:47,143,101; --journey-surface:#eaf6ef; --journey-canvas:#f7f3ea; --journey-ink:#143c38; }
view,scroll-view,button,input,textarea { box-sizing:border-box; }
button { margin:0; padding:0; font:inherit; line-height:1.4; color:inherit; background:transparent; border-radius:0; }
button::after { border:0; }
button[disabled] { opacity:.42; color:inherit; background:transparent; }
image { vertical-align:middle; }
.journey-primary-button,.primary { width:100%; min-height:49px; padding:12px 16px; display:flex; align-items:center; justify-content:center; gap:8px; border-radius:15px; background:var(--journey-accent-strong); color:white; font-size:16px; font-weight:400; box-shadow:0 9px 22px rgba(var(--journey-accent-rgb),.18); }
.journey-secondary-button,.secondary { width:100%; min-height:46px; margin-top:8px; border:1px solid #dfe6e3; border-radius:14px; padding:10px; background:#fff; color:#647671; font-size:16px; font-weight:400; }
.journey-danger-button { margin-top:14px; width:100%; min-height:42px; padding:11px; border:1px solid #efd2ce; border-radius:13px; background:#fff5f3; color:#9a504a; font-size:16px; font-weight:400; }
.journey-eyebrow,.eyebrow { font-size:8px; letter-spacing:.15em; color:var(--journey-accent); }
.journey-sheet-disclaimer,.disclaimer { margin-top:14px; color:#87958f; font-size:10px; line-height:1.6; text-align:center; }
.empty { padding:42px 20px; text-align:center; color:#87958f; font-size:12px; line-height:1.8; }
.empty-title { display:block; font-size:15px; font-weight:600; color:var(--journey-ink); margin-bottom:7px; }
.sheet-mask { position:fixed; inset:0; z-index:100; background:rgba(20,43,36,.35); display:flex; align-items:flex-end; }
.sheet { width:100%; max-height:88%; background:#fff; border-radius:25px 25px 0 0; padding:22px 20px calc(24px + env(safe-area-inset-bottom)); }
.sheet-heading { display:flex; justify-content:space-between; align-items:center; gap:12px; margin-bottom:16px; }
.sheet-title { display:block; font-family:"STSong","Songti SC",serif; font-size:24px; margin-top:6px; font-weight:600; }
.sheet-close { width:36px; height:36px; border-radius:50%; background:#f2f5f3; display:flex; align-items:center; justify-content:center; }
.sheet-body { max-height:65vh; }
.small-icon { width:18px; height:18px; flex:none; }
.native-top { background:var(--journey-canvas); }
.native-top-row { height:44px; display:flex; align-items:center; padding-left:16px; gap:9px; }
.native-back { width:32px; height:32px; display:flex; align-items:center; justify-content:center; border-radius:10px; }
.native-top-title { font-size:12px; font-weight:600; }


.is-reduced-motion view,.is-reduced-motion scroll-view,.is-reduced-motion button,.is-reduced-motion input,.is-reduced-motion textarea,.is-reduced-motion image,.is-reduced-motion text{transition-duration:.01ms!important;animation-duration:.01ms!important;animation-iteration-count:1!important;scroll-behavior:auto!important}
@media(prefers-reduced-motion:reduce){view,view::before,view::after,scroll-view,scroll-view::before,scroll-view::after,button,button::before,button::after,input,input::before,input::after,textarea,textarea::before,textarea::after,image,image::before,image::after,text,text::before,text::after{transition-duration:.01ms!important;animation-duration:.01ms!important;animation-iteration-count:1!important;scroll-behavior:auto!important}}

.builder-cards-list .journey-service-grid,.builder-cards-list .yw-feature-grid,.builder-cards-list .field-grid,.builder-cards-list .specialty-metric-grid{grid-template-columns:1fr}.builder-density-compact{padding:14px}.builder-density-compact .journey-assessment,.builder-density-compact .record-editor,.builder-density-compact .assessment-question{padding:12px}.builder-density-compact .field-grid,.builder-density-compact .journey-service-grid{gap:8px}.plan-field{display:block;margin:10px}.plan-field>text{display:block;font-size:13px}.plan-field input{padding:10px;border:1px solid #dce7df;border-radius:10px}
