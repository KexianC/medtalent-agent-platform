<view class="doctor-page {{layoutClass}} {{keyboardHeight > 0 && renderedTab === 'ask' ? 'keyboard-open' : ''}} {{reduceMotion ? 'is-reduced-motion' : ''}} {{doctor.slug === 'tang-jinsong' ? 'tang-page' : ''}}" style="{{theme}}height:{{windowHeight > 0 ? windowHeight + 'px' : '100%'}};--chat-safe-bottom:{{safeBottom}}px;--sheet-total-max:{{sheetTotalMax}}px;--sheet-feature-max:{{sheetFeatureMax}}px;">
  <view class="native-top" style="padding-top:{{statusBar}}px"><view class="native-top-row" style="padding-right:{{capsuleRight}}px"><button class="native-back" bindtap="back" aria-label="返回智能体矩阵"><image class="small-icon" src="{{icons.back}}"/></button><text class="native-top-title">智能体矩阵</text></view></view>
  <view wx:if="{{loading || error}}" class="state"><text class="state-title">{{loading ? '正在加载智能体' : '暂时无法加载智能体'}}</text><text>{{error || '正在获取最新发布的资料，请稍候。'}}</text><button wx:if="{{error}}" class="secondary" bindtap="load">重新加载</button><button class="secondary" bindtap="back">返回智能体矩阵</button></view>
  <block wx:elif="{{doctor}}">
    <view wx:if="{{dataBlocked}}" class="state"><text class="state-title">正在确认账户与记录</text><text>{{dataError}}</text><button class="secondary" data-action="refresh" bindtap="accountAction" disabled="{{accountBusy}}">重新确认账户</button><button wx:if="{{account.user}}" class="secondary" data-action="logout" bindtap="accountAction">退出登录，使用本机</button></view>
    <block wx:else>
      <view wx:for="{{ownerScopes}}" wx:for-item="renderOwner" wx:key="*this" class="page-body tab-motion {{renderedTab === 'ask' ? 'is-chat' : ''}} {{tabMotion}}">
        <scroll-view wx:if="{{renderedTab !== 'ask'}}" scroll-y class="panel-scroll" enhanced show-scrollbar="{{false}}" scroll-top="{{panelScrollTop}}" scroll-with-animation="{{!reduceMotion}}" bindscroll="panelScrolled">
          <native-wellness wx:if="{{renderedWellnessView}}" doctor="{{doctor}}" section="{{renderedTab}}" view="{{renderedWellnessView}}" revision="{{revision}}" bind:ask="openAsk" bind:close="closeWellness" bind:view="chooseWellness"/>
          <native-home owner-key="{{renderOwner}}" reduce-motion="{{reduceMotion}}" enter-motion="{{contentEntryMotion}}" wx:elif="{{renderedTab === 'home'}}" doctor="{{doctor}}" experience="{{experience}}" revision="{{revision}}" bind:ask="openAsk" bind:navigate="navigateFeature"/>
          <native-health id="health-workspace" observer-margins="{{panelViewportMargins}}" bind:viewport="measurePanelViewport" enter-motion="{{contentEntryMotion}}" reduce-motion="{{reduceMotion}}" wx:elif="{{renderedTab === 'manage' && !isWellness && !builderMode}}" doctor="{{doctor}}" experience="{{experience}}" revision="{{revision}}" bind:ask="openAsk" bind:focus="focusHealthEditor"/>
          <block wx:elif="{{(renderedTab === 'manage' && !builderMode) || (renderedTab === 'services' && isWellness)}}"><native-wellness doctor="{{doctor}}" section="{{renderedTab}}" view="" revision="{{revision}}" bind:ask="openAsk" bind:close="closeWellness" bind:view="chooseWellness"/><native-education wx:if="{{renderedTab === 'services' && serviceAllowed}}" compact="{{true}}" doctor="{{doctor}}" experience="{{experience}}" mode="services" bind:ask="openAsk" bind:navigate="navigateFeature"/></block>
          <block wx:elif="{{renderedTab === 'manage' && builderMode}}"><block wx:for="{{builderModules}}" wx:key="id"><native-health wx:if="{{item.id === 'records'}}" doctor="{{doctor}}" experience="{{experience}}" revision="{{revision}}" bind:ask="openAsk"/><native-assessments wx:if="{{item.id === 'assessments'}}" doctor="{{doctor}}" revision="{{revision}}" bind:ask="openAsk"/><native-wellness wx:if="{{item.id === 'wellness'}}" doctor="{{doctor}}" section="manage" view="" revision="{{revision}}" bind:ask="openAsk" bind:close="closeWellness" bind:view="chooseWellness"/></block></block>
          <native-education wx:elif="{{renderedTab === 'services'}}" doctor="{{doctor}}" experience="{{experience}}" revision="{{revision}}" mode="services" bind:ask="openAsk" bind:navigate="navigateFeature"/>
          <view wx:elif="{{renderedTab === 'me'}}" class="me-panel">
            <view class="panel-intro"><text class="eyebrow">PERSONAL CENTER</text><text class="panel-heading">我的</text><text class="panel-lead">管理你的健康记录、收藏与隐私设置。</text></view>
            <view class="user-card"><view class="user-badge"><image class="user-icon" src="{{icons.user}}"/></view><view class="user-copy"><text class="user-name">{{account.user && (profileName === '游客账户' || profileName === '微信用户') ? '微信用户' : profileName}}</text><text class="small-muted">{{account.user ? '微信账户 · 支持跨设备同步' : '游客体验 · 记录保存在本机'}}</text></view><button class="edit" data-panel="profile" bindtap="openPanel"><image class="small-icon" src="{{icons.meEdit}}"/> 编辑</button></view>
            <view class="account-card"><text class="account-title">{{account.user ? '微信账户已登录' : '微信登录，记录随你走'}}</text><text class="account-copy">{{syncLabel}}</text><button wx:if="{{!account.user}}" class="primary" hover-class="primary-pressed" hover-start-time="0" hover-stay-time="0" data-action="login" bindtap="accountAction" disabled="{{accountBusy}}">{{accountBusy ? '正在登录…' : '微信一键登录'}}</button><view wx:else class="account-actions"><button data-action="refresh" bindtap="accountAction" disabled="{{accountBusy}}">刷新同步</button><button wx:if="{{hasGuestData}}" data-action="import" bindtap="accountAction" disabled="{{accountBusy}}">迁移本机记录</button><button data-action="logout" bindtap="accountAction" disabled="{{accountBusy}}">退出登录</button></view><view wx:for="{{conflicts}}" wx:key="section" class="conflict"><text>记录冲突（{{item.label}}）</text><button data-section="{{item.section}}" data-choice="cloud" bindtap="resolveConflict">使用云端版本</button><button data-section="{{item.section}}" data-choice="local" bindtap="resolveConflict">保留本机版本</button></view><text wx:if="{{syncNotice || account.error}}" class="account-copy">{{syncNotice || account.error}}</text><text wx:if="{{!account.user}}" class="small-muted">请在 Medtalent 微信小程序内登录。本机游客记录由你选择是否迁移。</text></view>
            <view wx:if="{{isWellness}}" class="wellness-links"><button data-view="report" bindtap="openWellness"><image class="wellness-link-icon" src="{{icons.wellnessChart}}"/><view><text class="setting-title">我的身心报告</text><text class="small-muted">{{wellnessCounts.records}} 天记录 · {{wellnessCounts.sessions}} 次练习</text></view><image class="wellness-link-chevron" src="{{icons.wellnessChevron}}"/></button><button data-view="assessment" bindtap="openWellness"><image class="wellness-link-icon" src="{{icons.wellnessClipboard}}"/><view><text class="setting-title">我的自评记录</text><text class="small-muted">{{wellnessCounts.assessments}} 次已完成测评</text></view><image class="wellness-link-chevron" src="{{icons.wellnessChevron}}"/></button></view>
            <view class="menu"><button bindtap="openConsumerServices"><view class="me-menu-symbol"><image src="{{icons.meFile}}"/></view><text class="menu-title">预约、人工服务与私有报告</text><image class="me-menu-chevron" src="{{icons.meChevron}}"/></button><button wx:for="{{menu}}" wx:key="id" data-panel="{{item.id}}" bindtap="openPanel"><view class="me-menu-symbol"><image src="{{item.id === 'privacy' ? icons.meLock : item.id === 'about' ? icons.meSparkle : icons.meFile}}"/></view><text class="menu-title">{{item.title}}</text><text class="menu-count">{{item.count}}</text><image class="me-menu-chevron" src="{{icons.meChevron}}"/></button></view><button wx:if="{{isWellness && records.length}}" class="legacy-link" bindtap="openLegacyRecords">查看旧版健康记录（{{records.length}}）</button><text class="version">{{experience.eyebrow}} · 微信原生小程序版</text>
          </view>
        </scroll-view>
        <view wx:else class="chat">
          <view class="chat-header"><view class="mini-avatar"><view wx:if="{{doctor.portrait}}" class="portrait-frame" style="{{doctor.portraitStyle}}"><image src="{{doctor.portrait}}" style="{{doctor.slug === 'tang-jinsong' ? doctor.avatar36Style : doctor.avatar48Style}}" mode="scaleToFill" bindload="portraitLoaded" binderror="portraitFailed"/></view><text wx:else>{{doctor.initial}}</text></view><view class="chat-header-copy"><text class="chat-tagline">{{experience.tagline}}</text><text class="chat-name">{{doctor.name}}</text><text class="chat-subtitle"><text class="online-dot">●</text> 健康科普智能助手</text></view><view class="chat-tools"><button wx:if="{{voiceAllowed}}" class="autoplay {{privacy.voicePlayback ? '' : 'is-off'}}" bindtap="toggleAutoplay" aria-pressed="{{privacy.voicePlayback}}" aria-label="自动播报{{privacy.voicePlayback ? '开启' : '关闭'}}"><image class="small-icon" src="{{privacy.voicePlayback ? icons.speaker : '/assets/icons/speaker-autoplay-off.png'}}"/> 自动播报{{privacy.voicePlayback ? '开' : '关'}}</button><button class="clear-chat" bindtap="clearChat" disabled="{{messages.length <= 1 && !busy && voiceStatus !== 'recording' && voiceStatus !== 'starting' && voiceStatus !== 'transcribing'}}" aria-label="清空对话"><image class="small-icon" src="/assets/icons/delete-chat-control.png"/></button></view></view>
          <view class="safety"><image class="small-icon" src="/assets/icons/shield-chat-warning.png"/>健康科普仅供参考，急症请立即拨打 120</view>
          <scroll-view scroll-y enhanced show-scrollbar="{{false}}" class="messages" scroll-top="{{chatScrollTop}}" scroll-into-view="{{scrollTarget}}" scroll-with-animation="{{chatScrollAnimated && !reduceMotion}}" bindtouchstart="messagesTouchStarted" bindtouchmove="messagesTouchMoved" bind:dragstart="messagesDragStarted" bindscroll="messagesScrolled" bindscrolltolower="messagesAtBottom" lower-threshold="64"><view class="message-list">
            <native-guidance send-result="{{guidanceAck}}" wx:if="{{doctor.slug === 'tang-jinsong' && !builderMode}}" doctor="{{doctor}}" disabled="{{interactionLocked}}" revision="{{revision}}" bind:ask="openAsk"/>
            <view class="quick-questions"><button class="quick-summary" bindtap="toggleSuggestions" aria-expanded="{{suggestionsOpen}}"><text class="quick-marker" aria-hidden="{{true}}">{{suggestionsOpen ? '▼' : '▶'}}</text>推荐问题</button><view hidden="{{!suggestionsOpen}}"><scroll-view scroll-x class="suggestions" show-scrollbar="{{false}}"><view class="suggestion-list"><button wx:for="{{doctor.quickQuestions}}" wx:key="*this" wx:if="{{index < 3}}" data-question="{{item}}" bindtap="quickAsk" disabled="{{interactionLocked}}">{{item}}</button></view></scroll-view></view></view>
            <view wx:for="{{messages}}" wx:key="id" class="bubble-row {{item.role}} {{item.error ? 'is-error' : ''}} {{item.enterMotion ? 'message-enter' : ''}}"><view class="bubble-avatar"><view wx:if="{{item.role === 'assistant' && doctor.portrait}}" class="portrait-frame" style="{{doctor.portraitStyle}}"><image mode="scaleToFill" src="{{doctor.portrait}}" style="{{doctor.avatar31Style}}" bindload="portraitLoaded" binderror="portraitFailed"/></view><image wx:else class="small-icon user-avatar-icon" src="{{icons.userWhite}}"/></view><view class="bubble-content"><view class="bubble-text"><block wx:if="{{item.inputMode === 'voice' && item.role === 'user'}}"><view class="voice-message"><image src="{{icons.waveWhite}}" aria-hidden="{{true}}"/><text>{{' '}}语音消息{{item.voiceDurationSeconds ? ' · ' + item.voiceDurationSeconds + ' 秒' : ''}}</text></view><button class="transcript-toggle" data-id="{{item.id}}" bindtap="toggleTranscript" aria-expanded="{{item.expanded}}"><text class="disclosure-marker" aria-hidden="{{true}}">{{item.expanded ? '▼' : '▶'}}</text><text>查看识别内容</text></button><text wx:if="{{item.expanded}}" class="voice-transcript" selectable>{{item.body}}</text></block><text wx:else selectable>{{item.body}}</text></view><view wx:if="{{item.citations.length && doctor.citationsEnabled !== false}}" class="references"><button class="reference-toggle" data-id="{{item.id}}" bindtap="toggleCitations" aria-expanded="{{item.citationsExpanded}}"><view class="reference-label"><image src="{{icons.meFile}}" aria-hidden="{{true}}"/><text>参考资料</text></view><text class="reference-count">{{item.citations.length}} 项</text><view class="reference-caret {{item.citationsExpanded ? 'expanded' : ''}}" aria-hidden="{{true}}"/></button><view wx:if="{{item.citationsExpanded}}" class="reference-items"><view wx:for="{{item.citations}}" wx:for-item="citation" wx:key="index" class="reference-item"><text class="reference-index">[{{citation.index}}]</text><text class="reference-title">{{citation.title}}</text><button wx:if="{{citation.shareUrl}}" data-url="{{citation.shareUrl}}" bindtap="openExcerpt">阅读授权片段</button></view></view></view><text wx:if="{{item.role === 'assistant' && !item.error && !item.citations.length && item.notice && doctor.citationsEnabled !== false}}" class="no-references">参考资料：本次回答未附知识库引用。</text><text wx:if="{{item.notice}}" class="reply-notice">{{disclaimer}}</text><view class="message-actions"><button wx:if="{{item.role === 'assistant' && !item.error && item.notice}}" data-id="{{item.id}}" bindtap="feedbackAnswer">反馈</button><button wx:if="{{item.role === 'assistant' && !item.error && (!builderMode || voiceAllowed)}}" data-id="{{item.id}}" bindtap="readMessage" disabled="{{interactionLocked}}" aria-label="朗读回复"><image src="{{playingId === item.id ? '/assets/icons/stop-chat-action.png' : '/assets/icons/speaker-chat-action.png'}}"/></button><button wx:if="{{item.role === 'assistant' && !item.error}}" class="{{item.saved ? 'saved' : ''}}" data-id="{{item.id}}" bindtap="toggleFavorite" aria-label="收藏回复"><image src="{{item.saved ? icons.bookmarkFill : '/assets/icons/book-chat-action.png'}}"/></button><button data-id="{{item.id}}" bindtap="copyMessage" aria-label="复制内容"><image src="/assets/icons/copy-chat-action.png"/><text wx:if="{{copiedId === item.id}}">已复制</text></button><button wx:if="{{item.error}}" data-id="{{item.id}}" bindtap="retryMessage" disabled="{{interactionLocked}}">↻ 重试</button></view></view></view>
            <view wx:if="{{busy}}" class="bubble-row assistant"><view class="bubble-avatar"><view wx:if="{{doctor.portrait}}" class="portrait-frame" style="{{doctor.portraitStyle}}"><image src="{{doctor.portrait}}" style="{{doctor.avatar31Style}}" mode="scaleToFill" bindload="portraitLoaded" binderror="portraitFailed"/></view><text wx:else>{{doctor.initial}}</text></view><view class="bubble-content"><view class="bubble-text"><block wx:if="{{streamingReply}}"><text selectable>{{streamingReply}}</text><text class="streaming-cursor" aria-hidden="{{true}}"/></block><view wx:else class="typing" role="status" aria-live="polite" aria-label="正在生成回复"><view/><view/><view/></view></view></view></view><view wx:if="{{voiceError}}" id="tang-voice-error-details" class="voice-error-details"><button class="voice-error-summary" bindtap="toggleVoiceError" aria-expanded="{{voiceErrorExpanded}}" aria-controls="voice-error-copy"><text class="disclosure-marker" aria-hidden="{{true}}">{{voiceErrorExpanded ? '▼' : '▶'}}</text><text>语音提示 · 查看完整说明</text></button><text wx:if="{{voiceErrorExpanded}}" id="voice-error-copy" class="voice-error-copy" selectable>{{voiceError}}</text></view><view id="chat-bottom" class="chat-bottom"/></view>
          </scroll-view>

          <view wx:if="{{voiceStatusShown}}" class="voice-status {{voiceError ? 'error' : voiceStatus === 'recording' ? 'recording' : ''}}"><view class="voice-status-copy" role="{{voiceError ? 'alert' : 'status'}}" aria-live="{{voiceStatus === 'recording' ? 'off' : 'polite'}}"><image class="voice-status-icon" src="{{voiceError ? '/assets/icons/wave-chat-error.png' : voiceStatus === 'recording' ? '/assets/icons/wave-chat-recording.png' : '/assets/icons/wave-chat-status.png'}}" aria-hidden="{{true}}"/><button wx:if="{{voiceError}}" class="error-detail-toggle" bindtap="toggleVoiceError" aria-expanded="{{voiceErrorExpanded}}" aria-controls="tang-voice-error-details"><text>{{playbackStatus === 'blocked' ? '声音已暂停' : playbackStatus === 'error' ? '播报失败' : '语音暂不可用'}}</text><text class="error-detail-label">详情</text></button><text wx:else>{{voiceStatus === 'recording' ? '录音 ' + voiceElapsed + ' / 01:00' : voiceStatus === 'starting' ? '正在开启麦克风…' : voiceStatus === 'transcribing' ? '正在识别语音…' : playbackStatus === 'preparing' ? '正在准备播报' : playbackStatus === 'playing' ? '正在播报，可继续打字' : busy ? '正在整理回复…' : voiceMode ? '点击说话，说完点发送' : '可打字，或点话筒录音'}}</text></view><button wx:if="{{playbackStatus === 'blocked' || playbackStatus === 'error'}}" class="voice-retry" bindtap="retrySpeaking" disabled="{{interactionLocked}}" aria-label="{{playbackStatus === 'blocked' ? '恢复播报' : '重试播报'}}">{{playbackStatus === 'blocked' ? '恢复' : '重试'}}</button><button wx:if="{{playbackStatus === 'preparing' || playbackStatus === 'playing'}}" bindtap="stopSpeaking">停止播报</button><button wx:elif="{{busy || interactionLocked}}" bindtap="cancelWork">取消</button><button wx:elif="{{voiceError}}" class="hint-close" bindtap="dismissVoiceError" aria-label="关闭语音提示"><image src="/assets/icons/close-chat-error.png" aria-hidden="{{true}}"/></button><button wx:elif="{{playbackStatus === 'idle'}}" class="hint-close" bindtap="dismissHint" aria-label="关闭输入提示"><image src="{{icons.close}}" aria-hidden="{{true}}"/></button></view>
          <view class="chat-input"><text wx:if="{{healthContextNotice}}" class="context-notice">{{healthContextNotice}}</text><button wx:if="{{voiceAllowed}}" class="input-icon" bindtap="toggleVoice" disabled="{{busy && !voiceMode}}" aria-label="{{voiceMode ? '切换键盘输入' : '开始语音对话'}}"><image src="{{voiceMode ? icons.keyboard : icons.microphone}}"/></button><button wx:else class="input-icon upload-disabled" disabled aria-label="暂不支持报告上传"><image src="/assets/icons/imageSquare-chat-upload.png"/></button><button wx:if="{{healthSharing && !voiceMode}}" class="input-icon context {{shareHealthRecords ? 'selected' : ''}} {{healthCount ? '' : 'unavailable'}}" hover-class="context-pressed" hover-start-time="0" hover-stay-time="0" bindtap="toggleHealth" disabled="{{interactionLocked}}" aria-label="{{shareHealthRecords ? '本次已参考健康记录' : '本次参考健康记录'}}" aria-pressed="{{shareHealthRecords}}" aria-disabled="{{!healthCount || interactionLocked}}"><image src="{{!healthCount ? '/assets/icons/chart-context-unavailable.png' : shareHealthRecords ? '/assets/icons/chart-white.png' : '/assets/icons/chart-context-ready.png'}}"/><text wx:if="{{healthCount}}">{{healthCount}}</text></button><button wx:if="{{voiceMode}}" class="speak-button" bindtap="voiceAction" disabled="{{busy || voiceStatus === 'starting' || voiceStatus === 'transcribing'}}">{{voiceStatus === 'recording' ? '说完了，发送' : voiceStatus === 'starting' ? '正在开启麦克风…' : voiceStatus === 'transcribing' ? '正在识别…' : '点击说话'}}</button><block wx:else><input class="question-input" placeholder-style="color:#9ca3af;opacity:1" value="{{input}}" bindinput="inputChanged" bindconfirm="sendInput" confirm-type="send" maxlength="2000" adjust-position="{{false}}" bindkeyboardheightchange="keyboardChanged" bindfocus="inputFocused" bindblur="inputBlurred" disabled="{{voiceAllowed ? (voiceStatus === 'starting' || voiceStatus === 'recording' || voiceStatus === 'transcribing') : interactionLocked}}" placeholder="{{doctor.slug === 'tang-jinsong' ? '聊聊最近的睡眠、情绪或困扰…' : '描述你的健康问题…'}}"/><button class="send" bindtap="sendInput" disabled="{{interactionLocked || !input}}" aria-label="发送"><image src="/assets/icons/send-white.png"/></button></block></view>
        </view>
      </view>
    </block>
    <view class="bottom-nav"><button wx:for="{{tabs}}" wx:key="id" data-tab="{{item.id}}" bindtap="switchTab" class="{{tab === item.id ? 'active' : ''}}"><view class="nav-icon"><image src="{{tab === item.id ? item.image : item.mutedImage}}"/></view><text>{{item.label}}</text></button></view>
  </block>
  <view wx:if="{{activePanel}}" class="sheet-mask {{backdropMotion}}" bindtap="closePanel"><view class="sheet {{sheetMotion}}" catchtap="noop"><scroll-view scroll-y enhanced show-scrollbar="{{false}}" class="sheet-body"><view class="sheet-scroll-content"><view class="sheet-handle"/><view class="sheet-heading"><view><text class="eyebrow">{{panelEyebrow}}</text><text class="sheet-title">{{panelTitle}}</text></view><button class="sheet-close" bindtap="closePanel" aria-label="关闭"><image class="small-icon" src="{{icons.closeSheet}}"/></button></view>
    <block wx:if="{{activePanel === 'profile'}}"><label class="me-field"><text class="field-label">显示名称</text><input class="name-input" value="{{draftName}}" maxlength="16" placeholder="请输入名称" bindinput="draftNameChanged"/></label><button class="primary" hover-class="primary-pressed" hover-start-time="0" hover-stay-time="0" bindtap="saveProfile"><image class="small-icon" src="{{icons.saveWhite}}"/>保存资料</button><view class="me-disclaimer"><image src="{{icons.lockMuted}}"/><text>{{account.user ? '名称保存在你的账户中，可跨设备使用。' : '名称仅保存在当前设备，不会提交给医生。'}}</text></view></block>
    <block wx:elif="{{activePanel === 'favorites'}}"><view class="me-saved-list"><view wx:for="{{favorites}}" wx:key="id" class="saved-card"><text selectable class="saved-body">{{item.body}}</text><text class="reply-notice">{{disclaimer}}</text><text class="small-muted">{{item.createdLabel}}</text><view class="list-actions"><button data-id="{{item.id}}" bindtap="copyMessage"><image src="{{icons.copy}}"/>{{copiedId === item.id ? '已复制' : '复制'}}</button><button data-question="{{item.consultQuestion}}" bindtap="continueQuestion"><image src="{{icons.chat}}"/>继续咨询</button><button class="me-danger-action" data-id="{{item.id}}" bindtap="deleteFavorite" aria-label="取消收藏"><image src="{{icons.trashDanger}}"/></button></view></view></view><view wx:if="{{!favorites.length}}" class="empty"><image class="me-empty-icon" src="{{icons.emptyBookmark}}"/><text class="empty-title">暂无收藏</text><text class="empty-copy">在问医生页面点击回复下方的收藏按钮即可保存。</text></view><button wx:else class="danger" data-section="favorites" bindtap="clearSection"><image src="{{icons.trashDanger}}"/>清空收藏</button></block>
    <block wx:elif="{{activePanel === 'history'}}"><view class="me-history-list"><view wx:for="{{history}}" wx:key="id" class="saved-card me-history-card"><image class="me-history-icon" src="{{icons.chat}}"/><view><text class="saved-body">{{item.body}}</text><text class="small-muted">{{item.createdLabel}}</text></view><button class="me-inline-action" data-question="{{item.text}}" bindtap="continueQuestion">继续咨询</button></view></view><view wx:if="{{!history.length}}" class="empty"><image class="me-empty-icon" src="{{icons.emptyClock}}"/><text class="empty-title">暂无浏览记录</text><text class="empty-copy">你在智能问答中发送的问题会显示在这里。</text></view><button wx:else class="danger" data-section="chat-messages" bindtap="clearSection"><image src="{{icons.trashDanger}}"/>清空对话记录</button></block>
    <block wx:elif="{{activePanel === 'records'}}"><button class="primary" hover-class="primary-pressed" hover-start-time="0" hover-stay-time="0" bindtap="goManage"><image class="small-icon" src="{{icons.editWhite}}"/>填写记录与查看统计</button><view class="me-record-list"><view wx:for="{{records}}" wx:key="id" class="saved-card"><text class="record-date">{{item.dateLabel}}</text><text class="saved-body">{{item.summary}}</text><text wx:if="{{item.note}}" class="record-note">{{item.note}}</text><text class="record-source">{{item.source === 'home' ? '状态记录' : '健康管理'}}</text><view class="list-actions"><button disabled="{{doctor.slug === 'tang-jinsong' && !healthCount}}" data-question="{{doctor.slug === 'tang-jinsong' ? '请结合我最近的睡眠、情绪和日常状态记录，帮我看看最值得先调整的一点。' : '我想继续了解这次健康记录（' + item.dateLabel + '）：' + item.summary + (item.note ? '；补充：' + item.note : '')}}" data-health="{{doctor.slug === 'tang-jinsong'}}" bindtap="continueQuestion"><image src="{{icons.chat}}"/>{{doctor.slug === 'tang-jinsong' ? '带近期记录咨询' : '带记录咨询'}}</button><button class="me-danger-action" data-id="{{item.id}}" bindtap="deleteRecord"><image src="{{icons.trashDanger}}"/>删除</button></view></view></view><view wx:if="{{!records.length}}" class="empty"><image class="me-empty-icon" src="{{icons.emptyClipboard}}"/><text class="empty-title">暂无健康档案</text><text class="empty-copy">完成首页状态记录后会自动保存到这里。</text></view><button wx:else class="danger" data-section="health-records" bindtap="clearSection"><image src="{{icons.trashDanger}}"/>清空健康档案</button><view class="me-disclaimer"><image src="{{icons.shieldMuted}}"/><text>{{account.user ? '健康档案保存在你的账户中；' : '健康档案保存在当前设备；'}}只有你主动选择咨询时，才会向 AI 提交{{doctor.slug === 'tang-jinsong' ? '近期结构化摘要' : '所选记录内容'}}。</text></view></block>
    <block wx:elif="{{activePanel === 'privacy'}}"><text wx:if="{{syncNotice}}" class="privacy-error">{{syncNotice}}</text><view class="me-settings"><button class="me-setting-row" data-key="saveChat" bindtap="togglePrivacy" role="checkbox" aria-checked="{{privacy.saveChat}}"><view><text class="setting-title">保存对话记录</text><text class="setting-copy">{{account.user ? '将对话与心理自评保存在账户中，关闭时清除对应云端记录。' : doctor.slug === 'tang-jinsong' ? '将对话与心理自评保存在当前设备；关闭时清除本机副本。' : '将对话历史保存在当前设备；关闭时会立即清除本机副本。'}}</text></view><view class="me-setting-control"><view class="me-check {{privacy.saveChat ? 'is-checked' : ''}}"><view wx:if="{{privacy.saveChat}}" class="me-tick"/></view></view></button><button class="me-setting-row" data-key="voicePlayback" bindtap="togglePrivacy" role="checkbox" aria-checked="{{privacy.voicePlayback}}"><view><text class="setting-title">自动语音播报</text><text class="setting-copy">{{doctor.slug === 'tang-jinsong' ? '文字或语音提问后自动播放科普回复。' : '语音提问后自动播放科普回复。'}}</text></view><view class="me-setting-control"><view class="me-check {{privacy.voicePlayback ? 'is-checked' : ''}}"><view wx:if="{{privacy.voicePlayback}}" class="me-tick"/></view></view></button><button class="me-setting-row" data-key="reminders" bindtap="togglePrivacy" role="checkbox" aria-checked="{{privacy.reminders}}"><view><text class="setting-title">健康提醒</text><text class="setting-copy">显示首页健康记录提醒。</text></view><view class="me-setting-control"><view class="me-check {{privacy.reminders ? 'is-checked' : ''}}"><view wx:if="{{privacy.reminders}}" class="me-tick"/></view></view></button></view><button wx:if="{{!account.user}}" class="danger" bindtap="resetGuest"><image src="{{icons.trashDanger}}"/>清除数据并开始新游客体验</button><view class="me-privacy-explanation"><view wx:for="{{privacyParagraphs}}" wx:key="*this" class="me-disclaimer"><image wx:if="{{index === 0}}" src="{{icons.lockMuted}}"/><text>{{item}}</text></view></view></block>
    <block wx:elif="{{activePanel === 'about'}}"><view class="about-doctor"><view class="about-avatar"><view wx:if="{{doctor.portrait}}" class="portrait-frame" style="{{doctor.portraitStyle}}"><image src="{{doctor.portrait}}" style="{{doctor.avatar62Style}}" mode="scaleToFill" bindload="portraitLoaded" binderror="portraitFailed"/></view><text wx:else>{{doctor.initial}}</text></view><view class="me-about-identity"><text class="user-name">{{doctor.name}}</text><text class="small-muted">{{doctor.hospital}}</text><text class="small-muted">{{doctor.department}}</text></view></view><text class="me-feature-lead">本智能体围绕{{doctor.specialty}}提供健康科普、信息梳理和就医准备建议。</text><view class="me-checklist"><view><image src="{{icons.meShield}}"/><text>不提供诊断、处方或急救服务</text></view><view><image src="{{icons.meLock}}"/><text>记录可在各项历史或设置中删除</text></view><view><image src="{{icons.meSparkle}}"/><text>AI 回复可能存在局限，请结合专业意见判断</text></view></view><view class="me-disclaimer"><text>Medtalent 智能体平台 · 当前版本 1.3.0 · 支持微信账户同步</text></view></block>
  </view></scroll-view></view></view>
</view>
