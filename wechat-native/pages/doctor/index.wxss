.portrait-frame{width:100%;height:100%;position:relative;overflow:hidden;}.portrait-frame image{width:100%;height:100%;}.about-avatar{position:relative;width:62px;height:62px;flex:none;border-radius:50%;overflow:hidden;background:var(--journey-surface);display:flex;align-items:center;justify-content:center;}.about-doctor .portrait-frame image{border-radius:0;}

.me-panel{padding:28px 19px 26px;background:#f8f9f6;}.panel-intro{padding:2px 2px 0;}.panel-heading{font-size:29px;font-weight:600;margin:7px 0 6px;}.panel-lead{margin:0 0 20px;font-size:10px;color:#7e8e89;line-height:1.65;}.tang-page .panel-lead,.tang-page .account-copy{font-size:16px;line-height:1.65;}.tang-page .chat-name{font-size:20px;}.tang-page .messages{padding:17px 14px;}.tang-page .chat-input{padding-top:9px;padding-bottom:9px;}.tang-page .voice-status{background:var(--journey-surface);color:var(--journey-accent-strong);}
.chat-input{position:relative;}.context-notice{position:absolute;z-index:4;right:8px;bottom:calc(100% + 6px);max-width:calc(100% - 16px);padding:8px 11px;border:1px solid rgba(var(--journey-accent-rgb),.2);border-radius:10px;background:#fff;box-shadow:0 8px 24px rgba(31,61,50,.14);color:#536660;font-size:12px;line-height:1.35;pointer-events:none;}
.sheet-mask{background:rgba(18,41,37,.46);}.sheet{position:relative;max-height:88vh;max-height:min(88vh,720px);padding:0;overflow:hidden;border-radius:26px 26px 0 0;box-shadow:0 -20px 50px rgba(18,45,39,.18);display:flex;flex-direction:column;}.sheet-handle{flex:none;width:38px;height:4px;margin:-10px auto 18px;border-radius:5px;background:#dbe2df;}.sheet-heading{flex:none;min-height:56px;padding-right:45px;margin-bottom:16px;}.sheet-title{font-size:27px;font-weight:400;line-height:1.4;margin:6px 0 8px;}.sheet-close{position:absolute;top:18px;right:18px;width:40px;height:40px;}.sheet-body{min-height:0;max-height:88vh;max-height:min(88vh,720px);}.sheet-scroll-content{position:relative;box-sizing:border-box;padding:22px 20px calc(19px + env(safe-area-inset-bottom));}
.privacy-error{display:block;padding:10px 12px;margin-bottom:12px;border:1px solid #e8c9c3;border-radius:12px;background:#fff4ef;color:#92534b;line-height:1.5;}
.nav-icon{transition:background-color .2s ease,color .2s ease,transform .2s ease}.bottom-nav button.active .nav-icon{transform:translateY(-1px)}
.doctor-page .primary{transition:transform .18s ease,opacity .18s ease}.doctor-page .primary-pressed{transform:scale(.985)}
.context{transition:border-color .18s ease,background-color .18s ease,color .18s ease,transform .18s ease}.context.context-pressed{transform:scale(.94)}
.streaming-cursor{display:inline-block;width:2px;height:1.1em;margin-left:3px;vertical-align:-.14em;border-radius:1px;background:var(--journey-accent-strong);animation:doctor-streaming-cursor .85s ease-in-out infinite}.typing{display:flex;gap:4px}.typing>view{width:5px;height:5px;border-radius:50%;background:#93a29d;animation:doctor-typing 1s infinite}.typing>view:nth-child(2){animation-delay:.15s}.typing>view:nth-child(3){animation-delay:.3s}
@keyframes doctor-streaming-cursor{50%{opacity:.18}}@keyframes doctor-typing{50%{opacity:.28;transform:translateY(-2px)}}
.is-reduced-motion .typing>view,.is-reduced-motion .streaming-cursor{animation-duration:.01ms;animation-iteration-count:1}.is-reduced-motion .primary,.is-reduced-motion .context,.is-reduced-motion .nav-icon{transition-duration:.01ms}


