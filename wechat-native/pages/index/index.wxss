page{background:#f5f8fc;color:#12324b;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI","PingFang SC","Microsoft YaHei",sans-serif}button{margin:0;padding:0;font:inherit;line-height:inherit;border-radius:0;background:transparent}button::after{border:0}text{box-sizing:border-box}.icon{width:15px;height:15px;flex:none}.hub-shell{padding-bottom:calc(20px + env(safe-area-inset-bottom));overflow-x:hidden}.hub-header{height:60px;padding:0 16px;display:flex;align-items:center;justify-content:space-between;gap:12px;background:#fff;border-bottom:1px solid #e6eef6}.hub-brand{display:flex;align-items:center;gap:9px}.hub-logo{width:36px;height:36px;flex:none}.brand-title{display:block;color:#1768d8;font-size:16px;font-weight:760;line-height:1.15;letter-spacing:-.025em}.brand-caption{display:block;margin-top:1px;color:#627b94;font-size:11px;font-weight:500;letter-spacing:.09em}.hub-mobile-badge{display:flex;align-items:center;gap:4px;color:#547894;font-size:11px;white-space:nowrap}.hub-hero{padding:16px 16px 12px;background:linear-gradient(135deg,#edf7ff 0%,#f4fbff 62%,#edf9f8 100%);border-bottom:1px solid #dcebf8}.hub-title{display:block;color:#102e4a;font-size:26px;font-weight:760;line-height:1.25;letter-spacing:-.04em}.hub-question{display:block;margin:6px 0 10px;color:#55728c;font-size:12px;line-height:1.5}.hub-search{box-sizing:border-box;min-height:50px;padding:2px 2px 2px 12px;display:flex;align-items:center;gap:8px;border:1px solid #bdd9f4;border-radius:13px;background:#fff;box-shadow:0 3px 10px rgba(39,108,178,.05)}.search-icon{width:20px;height:20px;flex:none}.hub-search input{min-width:0;flex:1;height:44px;color:#173b5b;font-size:16px;line-height:1.5}.hub-search button{width:44px;height:44px;flex:none;border-radius:10px;background:#176fea;color:#fff;font-size:12px;font-weight:700;display:flex;align-items:center;justify-content:center}.hub-disclaimer{margin-top:10px;display:flex;align-items:flex-start;gap:6px;color:#60788e;font-size:12px;line-height:1.6}.hub-disc