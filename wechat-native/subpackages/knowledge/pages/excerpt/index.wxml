<view class="page"><text wx:if="{{loading}}">正在读取…</text><text wx:if="{{error}}" class="error">{{error}}</text><button wx:if="{{error && !feedback}}" bindtap="loadExcerpt">重试</button><view wx:if="{{excerpt}}"><text class="title">{{excerpt.title}}</text><text class="notice">引用片段 {{excerpt.chunkIndex + 1}}</text><text class="excerpt" selectable>{{excerpt.excerpt}}</text><text class="notice">{{excerpt.notice}}</text><button open-type="share">分享此授权片段</button></view><view wx:if="{{feedback}}"><text class="title">反馈这条回复</text><view wx:if="{{!done}}"><radio-group bindchange="changeRating"><label><radio value="helpful"/>有帮助</label><label><radio value="incorrect" checked/>内容纠错</label><label><radio value="unsafe"/>安全疑问</label></radio-group><textarea value="{{comment}}" maxlength="2000" bindinput="changeComment" placeholder="补充具体问题；请勿提交不必要的个人身份信息"/><button bindtap="submit" disabled="{{busy}}">{{busy ? '提交中…' : '提交反馈'}}</button></view><text wx:else>反馈已收到，将进入后台处理。</text></view></view>