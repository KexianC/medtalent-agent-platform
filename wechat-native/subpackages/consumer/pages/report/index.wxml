<view class="consumer-page"><view class="card"><text class="title">本人私有健康报告</text><text class="muted">原图和文字仅本人当前智能体可读，不作为公开知识。OCR需真实提供方；所有文字须人工核对，结果不构成诊断。</text></view><view wx:if="{{error}}" class="error">{{error}}</view><view wx:if="{{notice}}" class="notice">{{notice}}</view><view wx:if="{{!signedIn}}" class="card"><text>请登录微信后管理本人报告。</text><button bindtap="login">微信登录</button></view><block wx:else><button bindtap="refresh" disabled="{{busy || loading}}">{{loading ? '加载中' : '刷新报告列表'}}</button><view class="card"><label><switch checked="{{consent}}" bindchange="setConsent" disabled="{{busy}}"/>本人同意私有保存此图片；如选择OCR，同意发送至已配置的识别服务</label><text class="muted">PNG/JPEG/WebP，最多5MB。服务端会清除EXIF信息。{{capabilities.ocr === 'configured' ? 'OCR已配置，可请求真实识别。' : 'OCR尚未配置，请人工核对输入。'}}</text><button bindtap="upload" disabled="{{busy || !consent}}">选择图片并私有上传</button></view><view wx:for="{{reports}}" wx:key="id" class="card"><text class="heading">{{item.name}}</text><text class="muted">{{item.statusLabel}} · {{item.createdAt}}</text><text wx:if="{{item.error}}" class="error">{{item.error}}</text><view class="actions"><button size="mini" data-id="{{item.id}}" bindtap="preview" disabled="{{busy}}">查看私有原图</button><button size="mini" data-id="{{item.id}}" bindtap="select" disabled="{{busy}}">人工核对文字</button><button size="mini" data-id="{{item.id}}" bindtap="recognize" disabled="{{busy || !consent || capabilities.ocr !== 'configured' || item.status === 'processing'}}">请求OCR识别</button><button wx:if="{{item.status === 'confirmed'}}" size="mini" data-id="{{item.id}}" bindtap="toChat" disabled="{{busy}}">带确认文字咨询</button><button size="mini" data-id="{{item.id}}" bindtap="remove" disabled="{{busy}}">删除原图和文字</button></view></view><view wx:if="{{selectedId}}" class="card"><text class="heading">对照原报告核对</text><textarea value="{{draftText}}" bindinput="input" maxlength="50000" placeholder="请逐项核对项目名称、数值、单位、参考范围和报告日期。无OCR时可手工输入。"/><label><switch checked="{{reviewed}}" bindchange="setReviewed" disabled="{{busy}}"/>我已对照原图核对，确认这些文字</label><button bindtap="save" disabled="{{busy || !reviewed || !draftText}}">保存本人确认文字</button></view><view wx:if="{{shareReportId}}" class="card"><text class="heading">选择待咨询片段</text><text class="muted">最多1800字。完整私有报告与已确认文字保持不变，只带入你选录并核对的片段。</text><textarea value="{{shareText}}" bindinput="shareInput" maxlength="1800" placeholder="从报告选录与本次问题相关的项目、数值、单位及参考范围，并核对文字。"/><text class="muted">{{shareText.length}} / 1800 字</text><button bindtap="prepareChatDraft" disabled="{{busy || !shareText}}">核对片段并放入输入框</button></view></block></view>