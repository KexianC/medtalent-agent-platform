.consumer-page{padding:24rpx;background:#f4f7f6;color:#25443e;min-height:100vh}.card{padding:28rpx;background:#fff;border-radius:24rpx;margin-bottom:22rpx}.title,.heading{display:block;font-size:38rpx;font-weight:600;margin-bottom:18rpx}.heading{font-size:32rpx}.muted{display:block;color:#6b7d77;font-size:25rpx;line-height:1.7;margin:12rpx 0}.row{border-top:1rpx solid #e5eeea;padding:20rpx 0}.row text{display:block;line-height:1.7}.bubble{display:block;padding:16rpx;background:#edf4f0;margin:12rpx 0;white-space:pre-wrap;word-break:break-all}textarea{width:100%;box-sizing:border-box;min-height:130rpx;background:#f3f7f5;padding:20rpx;margin:18rpx 0;border-radius:16rpx}button{margin:16rpx 0;font-size:28rpx;background:#eaf4ed;color:#285d45}label{display:block;margin:18rpx 0;font-size:26rpx;line-height:1.7}.error,.notice{padding:22rpx;margin:18rpx 0;white-space:pre-wrap;border-radius:16rpx;background:#fff0ed;color:#9a422f}.notice{background:#e9f4ed;color:#2b6143}
textarea{min-height:420rpx}.actions{display:flex;flex-wrap:wrap;gap:12rpx}.actions button{margin:8rpx 0}