<view class="consumer-page"><view class="card"><text class="title">我的服务与授权</text><text class="muted">本人账户 · 当前智能体范围。真实外部服务未配置时会显示待接通。</text><button bindtap="openReport">查看本人健康报告</button></view><view wx:if="{{error}}" class="error">{{error}}</view><view wx:if="{{notice}}" class="notice">{{notice}}</view><view wx:if="{{paymentResult}}" class="notice">{{paymentResult}}</view><view wx:if="{{!signedIn}}" class="card"><text>登录微信后可查看本人服务记录。</text><button bindtap="login" disabled="{{busy}}">微信登录</button></view><block wx:else><button bindtap="refresh" disabled="{{loading || busy}}">{{loading ? '正在加载' : '刷新服务记录'}}</button><view class="card"><text class="heading">授权管理</text><label><switch checked="{{handoffConsent}}" data-field="handoffConsent" bindchange="consentChange" disabled="{{busy}}"/>允许该智能体的人工接管</label><label><switch checked="{{healthConsent}}" data-field="healthConsent" bindchange="consentChange" disabled="{{busy || !handoffConsent}}"/>允许人工服务读取本人当前智能体的健康记录摘要</label><button bindtap="saveConsent" disabled="{{busy}}">保存授权 / 撤回授权</button></view><view class="card"><text class="heading">预约申请</text><text class="muted">{{scope.capabilities.appointments === 'not_configured' ? '预约服务尚未开放。' : '提交后等待后台受理；不代表医生已接诊。'}}</text><textarea value="{{note}}" data-field="note" bindinput="input" maxlength="1000" placeholder="预约说明（可选）"/><view wx:for="{{scope.slots}}" wx:key="id" class="row"><text>{{item.label}} · {{item.timeLabel}} · {{item.priceLabel}} · 剩余{{item.remaining}}</text><button size="mini" data-id="{{item.id}}" bindtap="book" disabled="{{busy || item.remaining === 0 || scope.capabilities.appointments === 'not_configured'}}">申请此时段</button></view><view wx:for="{{scope.appointments}}" wx:key="id" class="row"><text>{{item.label}} · {{item.timeLabel}} · {{item.statusLabel}}</text><button wx:if="{{item.status === 'requested' || item.status === 'confirmed'}}" size="mini" data-id="{{item.id}}" bindtap="cancel" disabled="{{busy}}">取消申请</button><button wx:if="{{item.priceCents > 0 && (item.status === 'requested' || item.status === 'confirmed')}}" size="mini" data-id="{{item.id}}" bindtap="pay" disabled="{{busy || scope.capabilities.payment !== 'configured'}}">微信支付</button><button wx:if="{{item.status === 'requested' || item.status === 'confirmed'}}" size="mini" data-id="{{item.id}}" bindtap="subscribe" disabled="{{busy || scope.capabilities.subscription !== 'configured'}}">授权预约提醒</button></view><text wx:if="{{scope.capabilities.payment !== 'configured'}}" class="muted">支付商户未配置，无法发起支付。</text><text wx:if="{{scope.capabilities.subscription !== 'configured'}}" class="muted">订阅提供方未配置，无法发送提醒。</text></view><view class="card"><text class="heading">订单与订阅记录</text><view wx:for="{{scope.orders}}" wx:key="id" class="row"><text>{{item.title}} · {{item.statusLabel}}</text><button size="mini" data-id="{{item.id}}" bindtap="reconcile" disabled="{{busy}}">核对订单</button></view><text wx:for="{{scope.subscriptions}}" wx:key="id">提醒：{{item.statusLabel}}</text></view><view class="card"><text class="heading">人工服务</text><textarea value="{{message}}" data-field="message" bindinput="input" maxlength="2000" placeholder="描述需要人工协助的问题；请勿提交不必要身份信息"/><button bindtap="requestHandoff" disabled="{{busy || !scope.consent.handoff || !message}}">申请人工协助</button><view wx:for="{{scope.handoffs}}" wx:key="id" class="row"><text>{{item.statusLabel}}{{item.assignedTo ? ' · 已分配工作人员' : ''}}</text><view wx:for="{{item.messages}}" wx:for-item="messageRow" wx:key="id" class="bubble"><text>{{messageRow.role === 'consumer' ? '我' : '工作人员'}}：{{messageRow.text}}</text></view><button wx:if="{{item.status === 'requested' || item.status === 'active'}}" size="mini" data-id="{{item.id}}" bindtap="sendMessage" disabled="{{busy || !scope.consent.handoff || !message}}">发送补充消息</button><button wx:if="{{item.status !== 'closed'}}" size="mini" data-id="{{item.id}}" bindtap="closeHandoff" disabled="{{busy}}">结束人工服务</button></view></view><view class="card"><text class="heading">AI 工具提议</text><text class="muted">AI 仅提出动作；本人确认后才执行读取或写入。</text><textarea value="{{toolMessage}}" data-field="toolMessage" bindinput="input" maxlength="3000" placeholder="例如：请帮我准备预约申请"/><button bindtap="planTool" disabled="{{busy || !toolMessage}}">生成动作提议</button><view wx:for="{{scope.proposals}}" wx:key="id" class="row"><text>{{item.tool}} · {{item.statusLabel}}</text><text class="muted">{{item.expiresAt}}</text><button wx:if="{{item.status === 'proposed'}}" size="mini" data-id="{{item.id}}" bindtap="confirmTool" disabled="{{busy}}">查看并确认动作</button></view><text wx:if="{{toolResult}}" class="bubble">{{toolResult}}</text></view></block></view>