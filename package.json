{
  "name": "medtalent-agent-platform",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.4.0"
  },
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:api": "node --env-file-if-exists=.env.local --watch server/index.mjs",
    "start": "node --env-file-if-exists=.env.local server/index.mjs",
    "build": "tsc -b && vite build",
    "build:miniprograms": "node --env-file-if-exists=.env.local scripts/build-miniprograms.mjs",
    "build:native": "node scripts/build-native-miniprogram.mjs",
    "check:native": "node scripts/check-native-miniprogram.mjs",
    "test:native": "node --test --test-isolation=none tests/native-*.test.mjs",
    "package:native": "node scripts/package-native-miniprogram.mjs",
    "check:wechat": "node scripts/check-wechat-miniprogram.mjs",
    "check:wechat:release": "node scripts/check-wechat-miniprogram.mjs --release --online",
    "package:wechat": "node scripts/package-wechat-miniprogram.mjs",
    "test:wechat": "node --test --test-isolation=none tests/wechat-runtime.test.mjs tests/wechat-config.test.mjs tests/wechat-capabilities.test.mjs tests/wechat-h5-bridge.test.mjs server/wechat-bridge.test.mjs",
    "test": "node --test server/*.test.mjs tests/*.test.mjs",
    "backup": "node --env-file-if-exists=.env.local scripts/backup.mjs",
    "backup:mysql": "node --env-file-if-exists=.env.local scripts/backup-mysql.mjs",
    "migrate:mysql": "node --env-file-if-exists=.env.local scripts/migrate-sqlite-to-mysql.mjs",
    "verify:mysql": "node --env-file-if-exists=.env.local scripts/verify-sqlite-mysql-migration.mjs",
    "restore:mysql": "node --env-file-if-exists=.env.local scripts/restore-mysql-backup.mjs",
    "verify:restore:mysql": "node --env-file-if-exists=.env.local scripts/verify-mysql-backup-restore.mjs",
    "reset-admin": "node --env-file-if-exists=.env.local scripts/reset-admin.mjs",
    "reset-admin:mysql": "node --env-file-if-exists=.env.local scripts/reset-admin-mysql.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "check": "tsc -b --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1126.0",
    "@napi-rs/canvas": "^0.1.80",
    "@phosphor-icons/react": "^2.1.10",
    "@smithy/node-http-handler": "^4.12.1",
    "@tailwindcss/typography": "^0.5.19",
    "clsx": "^2.1.1",
    "express": "^5.1.0",
    "fast-xml-parser": "^5.11.1",
    "framer-motion": "^12.38.0",
    "lucide-react": "^0.511.0",
    "mammoth": "^1.12.2",
    "multer": "^2.3.0",
    "mysql2": "3.24.3",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^5.4.296",
    "proper-lockfile": "4.1.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.3",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.0.2",
    "tesseract.js": "^7.0.0",
    "ws": "^8.21.3",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@types/node": "^22.19.17",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.4.21",
    "babel-plugin-react-dev-locator": "^1.0.0",
    "concurrently": "^9.2.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "jszip": "^3.10.1",
    "motion-dom": "^12.38.0",
    "motion-utils": "^12.36.0",
    "postcss": "^8.5.3",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^8.2.2"
  }
}
