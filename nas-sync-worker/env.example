# 复制为 nas-sync-worker/.env.nas-sync，并将权限限制为仅运行账号可读。
# 改为自己 NAS 上的只读源目录；Compose 用此路径只读挂载。
NAS_TO_S3_HOST_SOURCE=/srv/agent-knowledge

# Worker 容器内部固定路径；原生 Node 运行时改为实际路径。
NAS_TO_S3_SOURCE_ROOT=/nas/knowledge
NAS_TO_S3_STATE_DIR=/state
NAS_TO_S3_SCAN_INTERVAL_SECONDS=300
NAS_TO_S3_STABLE_SECONDS=30
NAS_TO_S3_MAX_FILE_BYTES=52428800
NAS_TO_S3_MAX_SCAN_FILES=20000
NAS_TO_S3_MAX_FILES_PER_RUN=200
NAS_TO_S3_MAX_ATTEMPTS=4
NAS_TO_S3_RETRY_BASE_MS=500
NAS_TO_S3_VERIFY_AFTER_SECONDS=86400
# 即使 size+mtime 没变也定期重新计算 SHA-256；0 表示每轮都哈希。
NAS_TO_S3_REHASH_AFTER_SECONDS=3600
# 底层 HTTP 传输超时 + 每次 S3 调用的绝对 deadline（毫秒）。
NAS_TO_S3_CONNECTION_TIMEOUT_MS=3000
NAS_TO_S3_REQUEST_TIMEOUT_MS=30000
NAS_TO_S3_SOCKET_TIMEOUT_MS=30000
NAS_TO_S3_OPERATION_TIMEOUT_MS=45000
# 必须大于 NAS_TO_S3_OPERATION_TIMEOUT_MS；循环无进展后健康端点返回 503。
NAS_TO_S3_HEALTH_STALL_SECONDS=90
NAS_TO_S3_HEALTH_HOST=127.0.0.1
NAS_TO_S3_HEALTH_PORT=8790
NAS_TO_S3_DRY_RUN=false

# 稳定、非秘密的对象存储命名空间标识；更换 access key 时保持不变。
# 启用远端删除时必填。切换 endpoint/region/租户/bucket/全局前缀时必须使用新状态卷或人工迁移。
NAS_TO_S3_STORE_ID=nas-local-minio-agent-knowledge

# 默认只上传/覆盖，由 Worker 管理的远端对象不会因本地缺失而删除。
NAS_TO_S3_DELETE_REMOTE=false
# 只有确需删除时才同时设置：DELETE_MISSING_MANAGED_OBJECTS
NAS_TO_S3_DELETE_CONFIRM=

# 示例映射仅作参考；按自己平台的 slug 和 NAS 目录修改映射文件。
# 未映射的 NAS 目录只计入状态、不会上传，避免资料进入错误智能体。
NAS_TO_S3_AGENT_MAP_FILE=/app/nas-sync-worker/agent-map.example.json
NAS_TO_S3_REQUIRE_AGENT_MAP=true

# 专用 MinIO/S3 bucket 必须预先创建，Worker 不会自动创建。
# 此 Compose 使用 Linux host 网络；回环地址稳定指向 NAS 本机 MinIO，不能改填 DHCP 地址。
# 跨主机原生部署时应改用受保护的 HTTPS 地址。
NAS_S3_ENDPOINT=http://127.0.0.1:9000
NAS_S3_REGION=us-east-1
NAS_S3_BUCKET=agent-knowledge
NAS_S3_PREFIX=knowledge
NAS_S3_FORCE_PATH_STYLE=true
NAS_S3_ACCESS_KEY_ID=
NAS_S3_SECRET_ACCESS_KEY=
NAS_S3_SESSION_TOKEN=
