# Node 24.4+。复制为 .env.local；不要提交真实密钥。
# 原生 Node 上线必须改为 production；Docker Compose 已强制为 production。
NODE_ENV=development
PORT=8788
HOST=127.0.0.1
DATA_DIR=./data
# 留空继续使用 SQLite；设置后改用 MySQL，禁止在前端 VITE_ 变量中配置。
# 账号和密码必须按 URL 规范编码。
DATABASE_URL=
# required（默认；留空等同 required）或 disabled（已确认可信内网且明确选择不加密时）。
# Docker MySQL 模式叠加 compose.mysql.yml；disabled 无需配置或挂载 CA。
MYSQL_SSL_MODE=required
# TLS 原生运行填写 CA 的绝对路径；Docker 同时设置宿主机路径并叠加 compose.mysql-tls.yml。
MYSQL_SSL_CA_FILE=
MYSQL_SSL_CA_PATH=
# Docker 暴露到本机回环的可选端口；容器内仍固定 8788。
PLATFORM_PORT=8788
# 生产环境填平台的 HTTPS Origin，如 https://agents.example.com；开发留空。
PUBLIC_URL=
# 仅在明确经过一层受信任反向代理时设为 true。
TRUST_PROXY=

ADMIN_USERNAME=admin
# 开发环境留空时首次建库使用 dev-admin-password；生产必须设置独立强密码。
# 只在首次初始化数据库时创建账号，修改现有密码请使用 npm run reset-admin。
ADMIN_PASSWORD=
SESSION_HOURS=8
# 可选服务间管理令牌，生产至少32字符。不配置则只允许会话登录。
ADMIN_TOKEN=

# OpenAI-compatible chat/completions 接口：可填完整端点或 /v1 基础地址。
# 所有外部供应商密钥须为 8—8192 位、无空白的可打印 ASCII 值。
# 同时兼容旧 DEEPSEEK_API_KEY / DEEPSEEK_API_BASE / DEEPSEEK_MODEL。
AI_API_URL=https://api.deepseek.com
AI_API_KEY=
AI_MODEL=deepseek-v4-flash

# 可选向量模型：URL 必须是完整的 embeddings 端点。
# 未配置时使用真实中文关键词检索；配置后使用向量+关键词混合检索。
EMBEDDING_API_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
# openai（默认兼容格式）或 dashscope（阿里云百炼原生文本向量接口）。
EMBEDDING_API_PROTOCOL=openai
# 可选输出维度（供应商不支持时留空）；单次请求最多发送 20 条输入。
EMBEDDING_DIMENSIONS=
# 仅拆分发送给向量服务的文本，不改变知识片段数；按 Unicode 字符计数，范围 64—16000。
EMBEDDING_SEGMENT_CHARACTERS=225
EMBEDDING_BATCH_SIZE=8
# 每批瞬时失败的重试次数；仅重试网络异常、408/425/429 和 5xx，最大 5。
EMBEDDING_MAX_RETRIES=2

# 可选在线语音（沿用 demo 的 DashScope 语音服务）；密钥格式同上。
DASHSCOPE_API_KEY=

# 绿联 UGOS Pro：控制面板 -> 文件服务 -> WebDAV。
# 连接根地址是 WebDAV 地址，不是绿联云登录网页或 UGREENlink ID。
# 例如 https://nas.internal.example:5006/；必须使用可验证的TLS证书。
NAS_WEBDAV_URL=
NAS_WEBDAV_USERNAME=
NAS_WEBDAV_PASSWORD=
# 或先把 NAS SMB/NFS 共享只读挂载到服务器，再配置根目录。
# Windows 示例 Z:/AgentKnowledge；Docker 见 compose.nas-local.yml。
NAS_LOCAL_ROOT=
# 仅配合 compose.nas-local.yml：宿主机已经挂载且只读授权给容器的目录。
NAS_MOUNT_PATH=
# 或使用 MinIO / S3 兼容对象存储。后台映射的 path 会追加在此前缀下；
# 凭据只从服务器环境变量读取，切勿填写到后台表单或提交到版本库。
NAS_S3_ENDPOINT=https://minio.example.com
NAS_S3_REGION=us-east-1
NAS_S3_BUCKET=
NAS_S3_PREFIX=knowledge
NAS_S3_FORCE_PATH_STYLE=true
NAS_S3_ACCESS_KEY_ID=
NAS_S3_SECRET_ACCESS_KEY=
# 临时云凭据才需要。
NAS_S3_SESSION_TOKEN=
NAS_MAX_FILES=5000
NAS_MAX_DEPTH=12
NAS_MAX_FILE_BYTES=52428800
NAS_TIMEOUT_MS=20000
NAS_SCAN_TIMEOUT_MS=60000
NAS_SYNC_MAX_FILES_PER_RUN=100
NAS_SYNC_MAX_DURATION_MS=60000
# 知识库存储累计配额（统计尚未审核等所有未删除、仍引用当前原件的文档；软删除释放配额）。
# 更新同一文档只按新版本大小计一次；超限在写盘前及事务提交前双重校验。
KNOWLEDGE_MAX_DOCUMENTS_PER_SOURCE=5000
KNOWLEDGE_MAX_BYTES_PER_SOURCE=10737418240
KNOWLEDGE_MAX_DOCUMENTS_PER_AGENT=10000
KNOWLEDGE_MAX_BYTES_PER_AGENT=21474836480

# 可选：配合 compose.data-bind.yml 使用独立的宿主机数据目录（绝对路径）。
# 默认 Compose 使用命名卷；只改 DATA_DIR 不会改变容器挂载。
PLATFORM_DATA_PATH=

# 小程序工程生成时使用的正式 H5 域名；应与 PUBLIC_URL 一致。
H5_BASE_URL=
PLATFORM_API_URL=http://127.0.0.1:8788

# 微信小程序服务端凭据：必须与已发布的小程序 AppID 一致，禁止使用 VITE_ 前缀。
# 登录只兑换用户标识；不采集手机号，不把 AppSecret/session_key 发给客户端。
# 同步部署原生登录页，并将 H5 Origin 配置为小程序 request 合法域名后可启用。
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# 配好上述凭据后默认启用；设为 false 可暂停新登录和账户数据接口。
WECHAT_LOGIN_ENABLED=true

# 后台供应商：不设置时在 DATA_DIR/private-config 下生成本地加密密钥。
# 如集中管理，填写32字节随机密钥的base64；不要用VITE_前缀。
PROVIDER_ENCRYPTION_KEY=
ALLOW_LOCAL_PROVIDER_URLS=false

# OCR只读取明确配置的本地语言包，不会自动下载。支持同一目录raw或gzip格式。
OCR_LANG_PATH=
OCR_LANGUAGE=chi_sim+eng
CONSUMER_OCR_ENABLED=false

# 预约可在后台选择站内排班；真实外部接口须显式启用。
BUSINESS_APPOINTMENT_ENABLED=false
BUSINESS_APPOINTMENT_WEBHOOK_URL=
BUSINESS_APPOINTMENT_WEBHOOK_TOKEN=
BUSINESS_SUBSCRIPTION_ENABLED=false
BUSINESS_SUBSCRIPTION_WEBHOOK_URL=
BUSINESS_SUBSCRIPTION_WEBHOOK_TOKEN=
BUSINESS_SUBSCRIPTION_TEMPLATE_ID=
# 真实支付：仅证书路径，禁止把私钥/商户密钥放入前端或配置包。
BUSINESS_PAY_ENABLED=false
BUSINESS_WECHAT_APP_ID=
BUSINESS_WECHAT_MCH_ID=
BUSINESS_WECHAT_MCH_SERIAL=
BUSINESS_WECHAT_MCH_PRIVATE_KEY_PATH=
BUSINESS_WECHAT_PLATFORM_SERIAL=
BUSINESS_WECHAT_PLATFORM_PUBLIC_KEY_PATH=
BUSINESS_WECHAT_API_V3_KEY=
BUSINESS_WECHAT_NOTIFY_URL=

# 可选队列提示/共享限流；保留SQL队列和实例锁，尚不代表多写实例可用。
# worker与执行端须使用相同tenant和认证密钥，详见docs/distributed-runtime-local.md。
DISTRIBUTED_RUNTIME_ENABLED=false
DISTRIBUTED_TENANT_ID=internal
REDIS_URL=
REDIS_NAMESPACE=medtalent
REDIS_STREAM_GROUP=knowledge
REDIS_CLAIM_IDLE_MS=60000
DISTRIBUTED_WORKER_TOKEN=
DISTRIBUTED_EXECUTOR_URL=
DISTRIBUTED_EXECUTOR_ALLOWED_HOSTS=
DISTRIBUTED_CONSUMER_ID=
QDRANT_ENABLED=false
QDRANT_URL=
QDRANT_COLLECTION=
QDRANT_API_KEY=
QDRANT_ALLOWED_HOSTS=
